<Window
    x:Class="IndigoMovieManager.DmmPendingCandidatesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="DMM 未確定候補"
    Width="900"
    Height="480"
    MinWidth="720"
    MinHeight="360"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterOwner"
    PreviewKeyDown="Window_PreviewKeyDown">
    <materialDesign:ColorZone
        Padding="12,12,12,0"
        VerticalAlignment="Stretch">
        <Grid Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,8"
                Text="複数候補のため保留されたレコードです。選択して候補を確定してください。ダブルクリックでも候補選択を開けます。Ctrl+クリック／Shift+クリックで複数選択できます。"
                TextWrapping="Wrap" />

            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="FilterBox"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    materialDesign:HintAssist.Hint="ファイル名（&quot;で囲むと直接、それ以外は曖昧）"
                    materialDesign:HintAssist.IsFloating="False"
                    materialDesign:TextFieldAssist.HasClearButton="True"
                    materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                    FontSize="14"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                    TextChanged="FilterBox_TextChanged" />
                <CheckBox
                    x:Name="ShowInSkinCheckBox"
                    Grid.Column="1"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Content="スキンに表示"
                    ToolTip="候補を開くとき、メイン画面の現在スキンで対象ファイルを表示します（検索履歴には残しません）"
                    Checked="ShowInSkinCheckBox_Changed"
                    Unchecked="ShowInSkinCheckBox_Changed" />
                <TextBlock
                    x:Name="FilterCountText"
                    Grid.Column="2"
                    MinWidth="88"
                    VerticalAlignment="Center"
                    FontSize="12"
                    TextAlignment="Right"
                    Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
            </Grid>

            <DataGrid
                x:Name="PendingGrid"
                Grid.Row="2"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                HeadersVisibility="Column"
                IsReadOnly="True"
                PreviewMouseDoubleClick="PendingGrid_PreviewMouseDoubleClick"
                PreviewMouseLeftButtonUp="PendingGrid_PreviewMouseLeftButtonUp"
                SelectionMode="Extended"
                SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding MovieName}"
                        Header="ファイル名" />
                    <DataGridTextColumn
                        Width="160"
                        Binding="{Binding InitialKeyword}"
                        Header="初期検索語" />
                    <DataGridTextColumn
                        Width="60"
                        Binding="{Binding CandidateCount}"
                        Header="候補数" />
                    <DataGridTextColumn
                        Width="72"
                        Binding="{Binding SourceLabel}"
                        Header="発生元" />
                    <DataGridTextColumn
                        Width="140"
                        Binding="{Binding CreatedAtLabel}"
                        Header="保留日時" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="3" Margin="0,8,0,0">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                    Text="Powered by FANZA Webサービス"
                    TextWrapping="Wrap" />
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        x:Name="SelectAllButton"
                        MinWidth="96"
                        Margin="0,0,8,0"
                        Click="SelectAllButton_Click"
                        Content="全選択(_A)"
                        ToolTip="表示中の未確定候補をすべて選択します" />
                    <Button
                        x:Name="CleanupOrphansButton"
                        MinWidth="120"
                        Margin="0,0,8,0"
                        Click="CleanupOrphansButton_Click"
                        Content="孤児を削除(_O)"
                        ToolTip="登録から削除済みのレコードに紐づく未確定候補を一括削除します" />
                    <Button
                        x:Name="ResolveButton"
                        MinWidth="96"
                        Margin="0,0,8,0"
                        Click="ResolveButton_Click"
                        Content="候補を選ぶ(_R)" />
                    <Button
                        x:Name="DiscardButton"
                        MinWidth="88"
                        Margin="0,0,8,0"
                        Click="DiscardButton_Click"
                        Content="破棄(_D)"
                        ToolTip="選択中の未確定候補を破棄します（全選択後に実行すれば全件削除）" />
                    <Button
                        x:Name="CloseButton"
                        MinWidth="88"
                        Click="CloseButton_Click"
                        Content="閉じる(_C)"
                        IsCancel="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </materialDesign:ColorZone>
</Window>
