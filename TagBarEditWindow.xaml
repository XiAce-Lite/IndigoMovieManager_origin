<Window
    x:Class="IndigoMovieManager.TagBarEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="保存済み検索条件"
    Width="420"
    SizeToContent="Height"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner">
    <materialDesign:ColorZone Padding="12,12,12,0">
        <Grid Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox
                x:Name="TitleBox"
                Grid.Row="0"
                Margin="0,0,0,12"
                materialDesign:HintAssist.Hint="表示名"
                materialDesign:HintAssist.IsFloating="True"
                materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                FontSize="14" />

            <TextBox
                x:Name="ContentsBox"
                Grid.Row="1"
                Margin="0,0,0,12"
                materialDesign:HintAssist.Hint="検索条件"
                materialDesign:HintAssist.IsFloating="True"
                materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                AcceptsReturn="False"
                FontSize="14"
                TextWrapping="Wrap" />

            <StackPanel
                Grid.Row="2"
                HorizontalAlignment="Right"
                Orientation="Horizontal">
                <Button
                    x:Name="OkButton"
                    Width="88"
                    Margin="0,0,8,0"
                    Click="OkButton_Click"
                    Content="OK"
                    IsDefault="True" />
                <Button
                    x:Name="CancelButton"
                    Width="88"
                    Click="CancelButton_Click"
                    Content="キャンセル"
                    IsCancel="True" />
            </StackPanel>
        </Grid>
    </materialDesign:ColorZone>
</Window>
