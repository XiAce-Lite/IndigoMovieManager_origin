#!/bin/sh
# コミット前に FileVersion / AssemblyVersion の 4 桁目を +1 し、csproj を同じコミットに含める。

ROOT=$(git rev-parse --show-toplevel) || exit 1

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$ROOT/tools/bump-version.ps1" -RepoRoot "$ROOT"
if [ $? -ne 0 ]; then
  echo "pre-commit: bump-version.ps1 failed"
  exit 1
fi

git add "$ROOT/IndigoMovieManager.csproj" || exit 1

exit 0
