<Window
    x:Class="IndigoMovieManager.WatchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ModelView="clr-namespace:IndigoMovieManager.ModelViews"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="監視フォルダ編集"
    Width="800"
    MinWidth="800"
    MaxWidth="800"
    ResizeMode="NoResize"
    SizeToContent="Height"
    mc:Ignorable="d">

    <Window.Resources>
        <Style x:Key="WatchHeaderLineStyle" TargetType="TextBlock">
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <!-- MD の見た目を維持しつつ、少しだけ小さく -->
        <Style
            x:Key="WatchCheckBoxStyle"
            BasedOn="{StaticResource MaterialDesignCheckBox}"
            TargetType="CheckBox">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="LayoutTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="0.9" ScaleY="0.9" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.DataContext>
        <ModelView:WatchWindowViewModel />
    </Window.DataContext>

    <Grid>
        <materialDesign:ColorZone>
            <DockPanel Margin="10" LastChildFill="True">
                <StackPanel
                    x:Name="header"
                    Margin="0,0,0,8"
                    DockPanel.Dock="Top"
                    Orientation="Horizontal">
                    <Button
                        x:Name="BtnReturn"
                        Margin="10,4,0,4"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Click="BtnReturn_Click"
                        Content="戻る(_R)"
                        FontWeight="Normal" />
                    <TextBlock
                        x:Name="textBlock"
                        Margin="14,0,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Text="※次回起動時から有効です。"
                        TextWrapping="Wrap" />
                </StackPanel>

                <DataGrid
                    x:Name="WatchDataGrid"
                    HorizontalAlignment="Stretch"
                    AutoGenerateColumns="False"
                    CanUserAddRows="True"
                    CanUserDeleteRows="False"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="True"
                    CanUserResizeRows="False"
                    ColumnHeaderHeight="52"
                    HeadersVisibility="Column"
                    ItemsSource="{Binding WatchRecs, UpdateSourceTrigger=PropertyChanged}"
                    PreviewKeyDown="WatchDataGrid_PreviewKeyDown"
                    RowHeight="32"
                    ScrollViewer.CanContentScroll="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionMode="Single"
                    SelectionUnit="FullRow">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                            <Setter Property="Height" Value="32" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary.Light}" />
                                    <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Light.Foreground}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn
                            Width="68"
                            Binding="{Binding Auto, UpdateSourceTrigger=PropertyChanged}"
                            CanUserReorder="False"
                            CanUserResize="False"
                            CanUserSort="False"
                            ElementStyle="{StaticResource WatchCheckBoxStyle}"
                            EditingElementStyle="{StaticResource WatchCheckBoxStyle}">
                            <DataGridCheckBoxColumn.Header>
                                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                    <TextBlock Style="{StaticResource WatchHeaderLineStyle}" Text="起動時" />
                                    <TextBlock Style="{StaticResource WatchHeaderLineStyle}" Text="チェック" />
                                </StackPanel>
                            </DataGridCheckBoxColumn.Header>
                        </DataGridCheckBoxColumn>
                        <DataGridCheckBoxColumn
                            Width="56"
                            Binding="{Binding Watch, UpdateSourceTrigger=PropertyChanged}"
                            CanUserReorder="False"
                            CanUserResize="False"
                            CanUserSort="False"
                            ElementStyle="{StaticResource WatchCheckBoxStyle}"
                            EditingElementStyle="{StaticResource WatchCheckBoxStyle}">
                            <DataGridCheckBoxColumn.Header>
                                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                    <TextBlock Style="{StaticResource WatchHeaderLineStyle}" Text="起動中" />
                                    <TextBlock Style="{StaticResource WatchHeaderLineStyle}" Text="監視" />
                                </StackPanel>
                            </DataGridCheckBoxColumn.Header>
                        </DataGridCheckBoxColumn>
                        <DataGridCheckBoxColumn
                            Width="88"
                            Binding="{Binding Sub, UpdateSourceTrigger=PropertyChanged}"
                            CanUserReorder="False"
                            CanUserResize="False"
                            CanUserSort="False"
                            ElementStyle="{StaticResource WatchCheckBoxStyle}"
                            EditingElementStyle="{StaticResource WatchCheckBoxStyle}">
                            <DataGridCheckBoxColumn.Header>
                                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                    <TextBlock Style="{StaticResource WatchHeaderLineStyle}" Text="サブフォルダ" />
                                    <TextBlock Style="{StaticResource WatchHeaderLineStyle}" Text="監視" />
                                </StackPanel>
                            </DataGridCheckBoxColumn.Header>
                        </DataGridCheckBoxColumn>
                        <DataGridCheckBoxColumn
                            Width="82"
                            Binding="{Binding DmmAuto, UpdateSourceTrigger=PropertyChanged}"
                            CanUserReorder="False"
                            CanUserResize="False"
                            CanUserSort="False"
                            ElementStyle="{StaticResource WatchCheckBoxStyle}"
                            EditingElementStyle="{StaticResource WatchCheckBoxStyle}"
                            ToolTipService.ToolTip="この監視フォルダから新規登録されたファイルのみ、DMM 情報を自動取得します（既定 OFF）。">
                            <DataGridCheckBoxColumn.Header>
                                <StackPanel HorizontalAlignment="Center" Orientation="Vertical">
                                    <TextBlock Style="{StaticResource WatchHeaderLineStyle}" Text="DMM" />
                                    <TextBlock Style="{StaticResource WatchHeaderLineStyle}" Text="自動取得" />
                                </StackPanel>
                            </DataGridCheckBoxColumn.Header>
                        </DataGridCheckBoxColumn>
                        <DataGridTextColumn
                            x:Name="watchFolder"
                            Width="400"
                            MinWidth="80"
                            Binding="{Binding Dir, UpdateSourceTrigger=PropertyChanged}"
                            CanUserReorder="False"
                            CanUserResize="True"
                            CanUserSort="False"
                            Header="フォルダ"
                            IsReadOnly="True">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Dir}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn
                            Width="SizeToCells"
                            MinWidth="32"
                            CanUserReorder="False"
                            CanUserResize="False"
                            CanUserSort="False"
                            Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        Width="28"
                                        Height="28"
                                        Margin="2,0"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Click="OpenFolder_Click"
                                        Content="{materialDesign:PackIcon Kind=FolderOpen}"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="監視フォルダの選択" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn
                            Width="SizeToCells"
                            MinWidth="32"
                            CanUserReorder="False"
                            CanUserResize="False"
                            CanUserSort="False"
                            Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button
                                        Width="28"
                                        Height="28"
                                        Margin="2,0"
                                        Padding="0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Click="DeleteRow_Click"
                                        Content="{materialDesign:PackIcon Kind=Delete}"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="この行を削除" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </materialDesign:ColorZone>
    </Grid>
</Window>
