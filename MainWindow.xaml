<Window
    x:Class="IndigoMovieManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ModelView="clr-namespace:IndigoMovieManager.ModelViews"
    xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
    xmlns:c="clr-namespace:IndigoMovieManager.Converter"
    xmlns:controls="clr-namespace:IndigoMovieManager.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:IndigoMovieManager"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:view="clr-namespace:IndigoMovieManager.UserControls"
    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    x:Name="window"
    Title="Indigo Movie Manager"
    Width="800"
    Height="Auto"
    mc:Ignorable="d">

    <Window.Resources>
        <c:FileSizeConverter x:Key="FileSizeConverter" />
        <c:NoLockImageConverter x:Key="noLockImageConverter" />
        <!--  BoolToVisibilityConverter を追加  -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="SearchHistoryRemoveButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#99000000" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="11"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#22000000" />
                                <Setter Property="Foreground" Value="#DD000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="SearchHistoryItemContextMenu">
            <MenuItem Click="SearchHistoryDeleteMenuItem_Click" Header="この履歴を削除" />
        </ContextMenu>

        <ContextMenu x:Key="TagBarItemContextMenu">
            <MenuItem Click="TagBarRenameMenuItem_Click" Header="名前を変更" Tag="TagBarRenameMenuItem" />
            <MenuItem Click="TagBarEditContentsMenuItem_Click" Header="検索条件を編集" Tag="TagBarEditContentsMenuItem" />
            <MenuItem Click="TagBarDuplicateMenuItem_Click" Header="複製" />
            <Separator />
            <MenuItem Click="TagBarDeleteMenuItem_Click" Header="削除" Tag="TagBarDeleteMenuItem" />
        </ContextMenu>

        <Style x:Key="TagBarChipListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ContextMenu" Value="{StaticResource TagBarItemContextMenu}" />
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="TagBarItem_PreviewMouseLeftButtonDown" />
            <EventSetter Event="PreviewMouseDown" Handler="TagBarItem_PreviewMouseDown" />
            <EventSetter Event="ContextMenuOpening" Handler="TagBarItem_ContextMenuOpening" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Border"
                            Padding="10,5"
                            Background="{DynamicResource ImmTagBarChipBackground}"
                            BorderBrush="{DynamicResource ImmTagBarChipBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            SnapsToDevicePixels="True"
                            ToolTip="{Binding EffectiveContents}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ImmTagBarChipSelectedBackground}" />
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource ImmTagBarChipSelectedBorder}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource ImmTagBarChipSelectedBackground}" />
                                <Setter TargetName="Border" Property="Cursor" Value="Hand" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="SearchHistoryItemTemplate">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="2,0,4,0"
                    VerticalAlignment="Center"
                    Text="{Binding Find_Text}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    Grid.Column="1"
                    Click="SearchHistoryDeleteButton_Click"
                    Content="×"
                    Focusable="False"
                    IsTabStop="False"
                    Style="{StaticResource SearchHistoryRemoveButtonStyle}"
                    ToolTip="この履歴を削除" />
            </Grid>
        </DataTemplate>

        <Style x:Key="RecentFileRemoveButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="NavigationDrawerPrimaryItemTemplate" DataType="{x:Type local:NavigationDrawerItem}">
            <DockPanel Margin="0,0,1,0">
                <materialDesign:PackIcon
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                    Kind="{Binding IconKind}" />
                <TextBlock
                    Margin="10,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                    Text="{Binding Text}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Text}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="NavigationDrawerNestedItemTemplate" DataType="{x:Type local:NavigationDrawerItem}">
            <DockPanel Margin="1,0,1,0">
                <materialDesign:PackIcon
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                    Kind="{Binding IconKind}" />
                <TextBlock
                    Margin="10,4,10,2"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                    Text="{Binding Text}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Text}" />
            </DockPanel>
        </DataTemplate>

        <Style x:Key="NavigationDrawerListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ItemTemplate" Value="{StaticResource NavigationDrawerPrimaryItemTemplate}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style
            x:Key="NavigationDrawerNestedListBoxStyle"
            BasedOn="{StaticResource NavigationDrawerListBoxStyle}"
            TargetType="ListBox">
            <Setter Property="ItemTemplate" Value="{StaticResource NavigationDrawerNestedItemTemplate}" />
        </Style>

        <Style x:Key="NavigationDrawerListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,4,0,6" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled, FallbackValue=True}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="Transparent" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="NavigationDrawerRecentListBoxItemStyle"
            BasedOn="{StaticResource NavigationDrawerListBoxItemStyle}"
            TargetType="ListBoxItem" />

        <Style x:Key="NavigationDrawerSectionChevronStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="19" />
            <Setter Property="Height" Value="19" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
            <Setter Property="Kind" Value="ChevronRight" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Kind" Value="ChevronDown" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavigationDrawerSectionHeaderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsChecked" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Border"
                            Padding="4,4,0,6"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationDrawerSectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,4,10,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
        </Style>

        <ContextMenu x:Key="menuContext" FontSize="10" Opened="MenuContext_Opened">
            <MenuItem
                x:Name="PlayDefault"
                Click="PlayMovie_Click"
                Header="プレイヤーから開く(_E)"
                Icon="{materialDesign:PackIcon Kind=MoviePlay}"
                InputGestureText="ENTER">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                x:Name="PlayFromThumb"
                Click="PlayMovie_Click"
                Header="サムネイルから開く(_H)"
                Icon="{materialDesign:PackIcon Kind=MoviePlay}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator />
            <MenuItem
                x:Name="TagEdit"
                Click="TagEdit_Click"
                Header="タグ編集(_T)"
                Icon="{materialDesign:PackIcon Kind=Edit}"
                InputGestureText="F6">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                x:Name="TagAdd"
                Click="TagAdd_Click"
                Header="タグ追加(_A)"
                Icon="{materialDesign:PackIcon Kind=AttachmentAdd}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                x:Name="TagDelete"
                Click="TagDelete_Click"
                Header="タグ削除(_V)"
                Icon="{materialDesign:PackIcon Kind=RemoveBox}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                x:Name="TagCopy"
                Click="TagCopy_Click"
                Header="タグコピー(_C)"
                Icon="{materialDesign:PackIcon Kind=ContentCopy}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                x:Name="TagPaste"
                Click="TagPaste_Click"
                Header="タグ貼り付け(_V)"
                Icon="{materialDesign:PackIcon Kind=ContentPaste}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                x:Name="ScorePlus"
                Click="MenuScore_Click"
                Header="スコア +1 (_A)"
                Icon="{materialDesign:PackIcon Kind=Plus}"
                InputGestureText="+">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                x:Name="ScoreMinus"
                Click="MenuScore_Click"
                Header="スコア -1 (_S)"
                Icon="{materialDesign:PackIcon Kind=Minus}"
                InputGestureText="-">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator />
            <MenuItem
                Click="CreateThumb_EqualInterval"
                Header="等間隔サムネイル作成(_I)"
                Icon="{materialDesign:PackIcon Kind=Create}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <!--- ランダムサムネイルと画像からはなしにした
                                                <MenuItem Header="ランダムサムネイル作成(_R)" Icon="{materialDesign:PackIcon Kind=CreateOutline}" />
                                                <MenuItem Header="画像からサムネイル作成(_P)" Icon="{materialDesign:PackIcon Kind=Image}" />
            -->
            <MenuItem
                x:Name="ManualThumbnail"
                Click="ManualThumbnail_Click"
                Header="マニュアルサムネイル作成(_U)"
                Icon="{materialDesign:PackIcon Kind=Manufacturing}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                x:Name="RefreshFileInfo"
                Click="RefreshFileInfo_Click"
                Header="ファイル情報再取得(_F)"
                Icon="{materialDesign:PackIcon Kind=InformationOutline}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                x:Name="FetchDmmInfo"
                Click="FetchDmmInfo_Click"
                Header="DMM情報を取得(_N)"
                Icon="{materialDesign:PackIcon Kind=CloudDownloadOutline}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator />
            <MenuItem
                x:Name="DeleteMovie"
                Click="DeleteMovieRecord_Click"
                Header="登録から削除(_D)"
                Icon="{materialDesign:PackIcon Kind=Delete}"
                InputGestureText="DELETE">

                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                x:Name="FileCopy"
                Click="MenuCopyAndMove_Click"
                Header="ファイルをコピー(_C)"
                Icon="{materialDesign:PackIcon Kind=ContentCopy}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                x:Name="FileMove"
                Click="MenuCopyAndMove_Click"
                Header="ファイルを移動(_M)"
                Icon="{materialDesign:PackIcon Kind=MoveToInbox}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                x:Name="DeleteFile"
                Click="DeleteMovieRecord_Click"
                Header="ファイルを削除(_L)"
                Icon="{materialDesign:PackIcon Kind=RemoveCircle}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                x:Name="RenameFile"
                Click="RenameFile_Click"
                Header="ファイル名変更(_N)"
                Icon="{materialDesign:PackIcon Kind=Rename}"
                InputGestureText="F2">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator />
            <MenuItem
                Click="OpenParentFolder_Click"
                Header="親フォルダを開く(_F)"
                Icon="{materialDesign:PackIcon Kind=FolderOpen}"
                InputGestureText="F12">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <!-- この辺はウィンドウ作らないといけないので劣後だろうな。
                                                <MenuItem Header="プロパティ(_P)" Icon="{materialDesign:PackIcon Kind=PropertyTag}" InputGestureText="P">
                                                    <MenuItem.Style>
                                                        <Style TargetType="MenuItem">
                                                            <Setter Property="Padding" Value="1" />
                                                        </Style>
                                                    </MenuItem.Style>
                                                </MenuItem>
            -->
        </ContextMenu>

        <Style x:Key="HeaderComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource ImmHeaderDropdownItemBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource ImmHeaderDropdownItemForeground}" />
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ImmHeaderDropdownHighlightBackground}" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ImmHeaderDropdownHighlightBackground}" />
                    <Setter Property="Cursor" Value="Hand" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ImmHeaderDropdownHighlightBackground}" />
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Window.Background>
        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    </Window.Background>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
        <avalonDock:DockingManager x:Name="uxDockingManager" Margin="0,70,0,0">
            <avalonDock:DockingManager.Theme>
                <avalonDock:Vs2013LightTheme />
            </avalonDock:DockingManager.Theme>
            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Vertical">
                    <avalonDock:LayoutPanel
                        CanDock="False"
                        CanRepositionItems="False"
                        Orientation="Horizontal">
                        <avalonDock:LayoutDocumentPane
                            x:Name="uxDocumentPane"
                            CanRepositionItems="False"
                            ShowHeader="False">
                            <!--  ドキュメント  ★ここから  -->
                            <avalonDock:LayoutDocument Title="Document1" ContentId="Document1">
                                <Grid
                                    x:Name="MovieListHost"
                                    Margin="0"
                                    PreviewKeyDown="MovieListHost_PreviewKeyDown">
                                    <DockPanel x:Name="WpfSkinHost">
                                        <ScrollViewer
                                            x:Name="WpfSkinHeaderScroll"
                                            DockPanel.Dock="Top"
                                            HorizontalScrollBarVisibility="Hidden"
                                            VerticalScrollBarVisibility="Disabled"
                                            Visibility="Collapsed">
                                            <ContentControl x:Name="WpfSkinHeaderHost" />
                                        </ScrollViewer>
                                        <ListView
                                            x:Name="WpfSkinList"
                                            BorderThickness="0"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            ScrollViewer.IsDeferredScrollingEnabled="True"
                                            ScrollViewer.ScrollChanged="WpfSkinList_ScrollChanged"
                                            SelectionChanged="List_SelectionChanged"
                                            SelectionMode="Extended"
                                            VirtualizingPanel.IsVirtualizing="True"
                                            VirtualizingPanel.ScrollUnit="Pixel"
                                            VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                    <Setter Property="VerticalContentAlignment" Value="Top" />
                                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="WpfSkinItem_PreviewMouseLeftButtonDown" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                        </ListView>
                                    </DockPanel>
                                    <DockPanel
                                        x:Name="WbSkinHost"
                                        Visibility="Collapsed">
                                        <view:SkinView
                                            x:Name="SkinViewGridWb"
                                            SelectionChanged="SkinView_SelectionChanged" />
                                    </DockPanel>
                                </Grid>
                            </avalonDock:LayoutDocument>
                            <!--  ドキュメント ★ここまで  -->
                        </avalonDock:LayoutDocumentPane>
                    </avalonDock:LayoutPanel>
                    <avalonDock:LayoutAnchorablePane x:Name="uxAnchorablePane2" DockHeight="240">

                        <!--  ツールウィンドウ  -->
                        <!--  何故かクローズ（非表示なんだけど）閉じて保存すると二度と表示されないのでクローズ禁止にした  -->
                        <avalonDock:LayoutAnchorable
                            x:Name="exDetail"
                            Title="詳細"
                            AutoHideHeight="200"
                            CanAutoHide="True"
                            CanClose="False"
                            CanDockAsTabbedDocument="False"
                            CanHide="False"
                            ContentId="ToolExtension">
                            <view:ExtDetail x:Name="viewExtDetail" Visibility="Hidden" />
                        </avalonDock:LayoutAnchorable>

                        <avalonDock:LayoutAnchorable
                            x:Name="exBookMark"
                            Title="ブックマーク"
                            AutoHideHeight="200"
                            CanAutoHide="True"
                            CanClose="False"
                            CanDockAsTabbedDocument="False"
                            CanHide="False"
                            ContentId="ToolBookmark">
                            <ListView
                                x:Name="BookmarkList"
                                ItemsSource="{Binding BookmarkRecs, UpdateSourceTrigger=PropertyChanged}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                ScrollViewer.IsDeferredScrollingEnabled="True"
                                SelectionMode="Extended"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.VirtualizationMode="Recycling">

                                <ListView.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <vwp:VirtualizingWrapPanel
                                            Orientation="Horizontal"
                                            SpacingMode="BetweenItemsOnly"
                                            StretchItems="True"
                                            VirtualizingPanel.IsVirtualizing="True" />
                                    </ItemsPanelTemplate>
                                </ListView.ItemsPanel>

                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <!--  内容更新時のバインドエラー回避のおまじない。  -->
                                        <Setter Property="HorizontalAlignment" Value="Left" />
                                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <view:Bookmark x:Name="viewBookmark" DataContext="{Binding}" />
                                    </DataTemplate>
                                </ListView.ItemTemplate>

                            </ListView>

                        </avalonDock:LayoutAnchorable>
                        <!--  ツールウィンドウ  -->
                        <avalonDock:LayoutAnchorable
                            x:Name="TagBar"
                            Title="保存済み検索条件"
                            AutoHideHeight="200"
                            CanAutoHide="True"
                            CanClose="False"
                            CanDockAsTabbedDocument="False"
                            CanHide="False"
                            ContentId="ToolTagBar">
                            <DockPanel Margin="6">
                                <StackPanel
                                    Margin="0,0,0,6"
                                    DockPanel.Dock="Top"
                                    Orientation="Horizontal">
                                    <Button
                                        Margin="0,0,6,0"
                                        Click="TagBarAdd_Click"
                                        Content="＋ 追加" />
                                    <Button
                                        x:Name="TagBarEditButton"
                                        Margin="0,0,6,0"
                                        Click="TagBarEdit_Click"
                                        Content="編集"
                                        IsEnabled="False" />
                                    <Button
                                        x:Name="TagBarDeleteButton"
                                        Click="TagBarDelete_Click"
                                        Content="削除"
                                        IsEnabled="False" />
                                </StackPanel>
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ListBox
                                        x:Name="TagBarList"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ItemsSource="{Binding TagBarRecs, UpdateSourceTrigger=PropertyChanged}"
                                        SelectionChanged="TagBarList_SelectionChanged"
                                        SelectionMode="Single">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style BasedOn="{StaticResource TagBarChipListBoxItemStyle}" TargetType="ListBoxItem" />
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    FontSize="13"
                                                    Foreground="{DynamicResource ImmTagBarChipForeground}"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </ScrollViewer>
                            </DockPanel>
                        </avalonDock:LayoutAnchorable>
                    </avalonDock:LayoutAnchorablePane>

                </avalonDock:LayoutPanel>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>

        <materialDesign:DrawerHost IsLeftDrawerOpen="{Binding IsChecked, ElementName=MenuToggleButton}">
            <materialDesign:DrawerHost.LeftDrawerContent>
                <DockPanel MinWidth="220">
                    <ToggleButton
                        Margin="16"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Top"
                        IsChecked="{Binding IsChecked, ElementName=MenuToggleButton, Mode=TwoWay}"
                        Style="{StaticResource MaterialDesignHamburgerToggleButton}" />

                    <ScrollViewer
                        Margin="16,4"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ListBox
                                x:Name="PrimaryNavList"
                                Margin="9,0,0,0"
                                ItemContainerStyle="{StaticResource NavigationDrawerListBoxItemStyle}"
                                ItemsSource="{Binding PrimaryNavItems}"
                                PreviewMouseLeftButtonUp="NavigationList_PreviewMouseLeftButtonUp"
                                Style="{StaticResource NavigationDrawerListBoxStyle}" />

                            <ToggleButton
                                x:Name="RecentSectionToggle"
                                Style="{StaticResource NavigationDrawerSectionHeaderToggleStyle}">
                                <DockPanel Margin="1,0,1,0">
                                    <materialDesign:PackIcon Style="{StaticResource NavigationDrawerSectionChevronStyle}" />
                                    <materialDesign:PackIcon VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" Kind="History" />
                                    <TextBlock Style="{StaticResource NavigationDrawerSectionHeaderTextStyle}" Text="最近開いたファイル" />
                                </DockPanel>
                            </ToggleButton>
                            <ListBox
                                x:Name="RecentNavList"
                                Margin="19,0,0,0"
                                ItemContainerStyle="{StaticResource NavigationDrawerRecentListBoxItemStyle}"
                                ItemsSource="{Binding RecentFileItems, UpdateSourceTrigger=PropertyChanged}"
                                PreviewMouseLeftButtonUp="NavigationList_PreviewMouseLeftButtonUp"
                                PreviewMouseRightButtonDown="RecentNavList_PreviewMouseRightButtonDown"
                                Style="{StaticResource NavigationDrawerNestedListBoxStyle}"
                                Visibility="{Binding IsChecked, ElementName=RecentSectionToggle, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <ToggleButton
                                x:Name="SettingsSectionToggle"
                                Style="{StaticResource NavigationDrawerSectionHeaderToggleStyle}">
                                <DockPanel Margin="1,0,1,0">
                                    <materialDesign:PackIcon Style="{StaticResource NavigationDrawerSectionChevronStyle}" />
                                    <materialDesign:PackIcon VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" Kind="SettingsApplications" />
                                    <TextBlock Style="{StaticResource NavigationDrawerSectionHeaderTextStyle}" Text="設定" />
                                </DockPanel>
                            </ToggleButton>
                            <ListBox
                                x:Name="SettingsNavList"
                                Margin="19,0,0,0"
                                ItemContainerStyle="{StaticResource NavigationDrawerListBoxItemStyle}"
                                ItemsSource="{Binding SettingsNavItems}"
                                PreviewMouseLeftButtonUp="NavigationList_PreviewMouseLeftButtonUp"
                                Style="{StaticResource NavigationDrawerNestedListBoxStyle}"
                                Visibility="{Binding IsChecked, ElementName=SettingsSectionToggle, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <ToggleButton
                                x:Name="ToolSectionToggle"
                                Style="{StaticResource NavigationDrawerSectionHeaderToggleStyle}">
                                <DockPanel Margin="1,0,1,0">
                                    <materialDesign:PackIcon Style="{StaticResource NavigationDrawerSectionChevronStyle}" />
                                    <materialDesign:PackIcon VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesign.Brush.Primary}" Kind="Toolbox" />
                                    <TextBlock Style="{StaticResource NavigationDrawerSectionHeaderTextStyle}" Text="ツール" />
                                </DockPanel>
                            </ToggleButton>
                            <ListBox
                                x:Name="ToolNavList"
                                Margin="19,0,0,0"
                                ItemContainerStyle="{StaticResource NavigationDrawerListBoxItemStyle}"
                                ItemsSource="{Binding ToolNavItems}"
                                PreviewMouseLeftButtonUp="NavigationList_PreviewMouseLeftButtonUp"
                                Style="{StaticResource NavigationDrawerNestedListBoxStyle}"
                                Visibility="{Binding IsChecked, ElementName=ToolSectionToggle, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <ListBox
                                x:Name="ExitNavList"
                                Margin="9,0,0,0"
                                ItemContainerStyle="{StaticResource NavigationDrawerListBoxItemStyle}"
                                ItemsSource="{Binding ExitNavItems}"
                                PreviewMouseLeftButtonUp="NavigationList_PreviewMouseLeftButtonUp"
                                Style="{StaticResource NavigationDrawerListBoxStyle}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </materialDesign:DrawerHost.LeftDrawerContent>

                <materialDesign:ColorZone
                    x:Name="HeaderZone"
                    HorizontalAlignment="Stretch"
                    Padding="16,3,16,1"
                    VerticalAlignment="Top"
                    Mode="PrimaryDark"
                    Loaded="HeaderZone_Loaded"
                    SizeChanged="HeaderZone_SizeChanged">
                    <Grid x:Name="HeaderLayoutGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ToggleButton
                            x:Name="MenuToggleButton"
                            Grid.Row="0"
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="HamburgerToggleButton"
                            Style="{DynamicResource MaterialDesignHamburgerToggleButton}" />

                        <StackPanel
                            x:Name="HeaderSearchPanel"
                            Grid.Row="0"
                            Grid.Column="1"
                            Margin="8,0,12,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <ComboBox
                                x:Name="SearchBox"
                                MinWidth="180"
                                Width="326"
                                Height="Auto"
                                Margin="0,0,4,0"
                                Padding="4,2,0,2"
                                VerticalAlignment="Center"
                                HorizontalContentAlignment="Stretch"
                                materialDesign:HintAssist.Hint="検索キーワードを入れて下さい。"
                                materialDesign:HintAssist.IsFloating="False"
                                materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                materialDesign:TextFieldAssist.HasClearButton="True"
                                materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                                materialDesign:TextFieldAssist.TextFieldCornerRadius="3"
                                Background="{DynamicResource ImmHeaderInputBackground}"
                                DropDownClosed="SearchBox_DropDownClosed"
                                DropDownOpened="SearchBox_DropDownOpened"
                                Loaded="ComboBoxArrow_Loaded"
                                FontSize="14"
                                Foreground="{DynamicResource ImmHeaderInputForeground}"
                                IsEditable="True"
                                ItemTemplate="{StaticResource SearchHistoryItemTemplate}"
                                ItemsSource="{Binding HistoryRecs}"
                                MaxDropDownHeight="600"
                                VirtualizingPanel.IsVirtualizing="False"
                                LostFocus="SearchBox_LostFocus"
                                IsTextSearchEnabled="False"
                                PreviewKeyDown="SearchBox_PreviewKeyDown"
                                SelectionChanged="SearchBox_SelectionChanged"
                                SelectiveScrollingGrid.SelectiveScrollingOrientation="None"
                                TextSearch.TextPath="Find_Text"
                                Text="{Binding DbInfo.SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                TextBoxBase.TextChanged="SearchBox_TextChanged">
                                <ComboBox.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource HeaderComboBoxItemStyle}" TargetType="ComboBoxItem">
                                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                        <Setter Property="ContextMenu" Value="{StaticResource SearchHistoryItemContextMenu}" />
                                        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="SearchBoxItem_PreviewMouseLeftButtonDown" />
                                        <EventSetter Event="PreviewKeyDown" Handler="SearchBoxItem_PreviewKeyDown" />
                                    </Style>
                                </ComboBox.ItemContainerStyle>
                            </ComboBox>
                            <Button
                                x:Name="SaveSearchTagButton"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Click="SaveSearchTagButton_Click"
                                Style="{StaticResource MaterialDesignIconButton}"
                                ToolTip="現在の検索を保存">
                                <materialDesign:PackIcon Kind="Plus" />
                            </Button>
                            <Button
                                x:Name="ReloadButton"
                                MinWidth="52"
                                Padding="10,2"
                                VerticalAlignment="Center"
                                Click="ReloadButton_Click"
                                Content="更新"
                                IsDefault="True"
                                ToolTip="一覧を更新（検索・ソートを再適用）" />
                        </StackPanel>

                        <StackPanel
                            x:Name="HeaderToolbarHost"
                            Grid.Row="0"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <StackPanel
                                x:Name="HeaderModePanel"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource ImmHeaderLabelForeground}"
                                    Text="方式:" />
                                <Border
                                    Margin="0,0,0,0"
                                    Padding="1"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource ImmHeaderSegmentGroupBackground}"
                                    BorderBrush="{DynamicResource ImmHeaderSegmentGroupBorder}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    SnapsToDevicePixels="True">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton
                                            x:Name="ModeWpfRadio"
                                            Checked="SkinModeRadio_Checked"
                                            Content="Indigo"
                                            GroupName="SkinMode"
                                            Style="{StaticResource HeaderSegmentRadio}"
                                            ToolTip="Indigo ネイティブスキン"
                                            controls:SegmentRadioAssist.CornerRadius="4,4,0,0" />
                                        <RadioButton
                                            x:Name="ModeWbRadio"
                                            Margin="-1,0,0,0"
                                            Checked="SkinModeRadio_Checked"
                                            Content="WB"
                                            GroupName="SkinMode"
                                            Style="{StaticResource HeaderSegmentRadio}"
                                            ToolTip="WhiteBrowser 互換スキン"
                                            controls:SegmentRadioAssist.CornerRadius="0,0,4,4" />
                                    </StackPanel>
                                </Border>
                                <TextBlock
                                    Margin="12,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource ImmHeaderLabelForeground}"
                                    Text="スキン:" />
                                <ComboBox
                                    x:Name="ComboSkin"
                                    Width="150"
                                    Margin="0,0,4,0"
                                    Padding="4,2,0,2"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                                    materialDesign:TextFieldAssist.TextFieldCornerRadius="3"
                                    Background="{DynamicResource ImmHeaderInputBackground}"
                                    Foreground="{DynamicResource ImmHeaderInputForeground}"
                                    ItemContainerStyle="{StaticResource HeaderComboBoxItemStyle}"
                                    Loaded="ComboBoxArrow_Loaded"
                                    SelectionChanged="ComboSkin_SelectionChanged" />
                                <Grid
                                    Width="40"
                                    Height="40"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                    <Button
                                        x:Name="ReloadSkinButton"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Click="ReloadSkin_Click"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        ToolTip="スキンを再読込"
                                        Visibility="Collapsed">
                                        <materialDesign:PackIcon Kind="Refresh" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                            <StackPanel
                                x:Name="HeaderSortPanel"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    x:Name="HeaderSortLabel"
                                    Margin="8,0,4,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource ImmHeaderLabelForeground}"
                                    Text="ソート:" />
                                <ComboBox
                                    x:Name="ComboSort"
                                    Width="195"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                                    materialDesign:TextFieldAssist.TextFieldCornerRadius="3"
                                    Background="{DynamicResource ImmHeaderInputBackground}"
                                    DisplayMemberPath="Name"
                                    Foreground="{DynamicResource ImmHeaderInputForeground}"
                                    ItemContainerStyle="{StaticResource HeaderComboBoxItemStyle}"
                                    ItemsSource="{Binding SortLists}"
                                    Loaded="ComboBoxArrow_Loaded"
                                    SelectedValue="{Binding DbInfo.Sort}"
                                    SelectedValuePath="Id"
                                    SelectionChanged="ComboSort_SelectionChanged" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource ImmHeaderLabelForeground}"
                                    Text="{Binding DbInfo.SearchCount, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock
                                    Margin="4,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource ImmHeaderLabelForeground}"
                                    Text="/" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource ImmHeaderLabelForeground}"
                                    Text="{Binding MovieRecs.Count, UpdateSourceTrigger=PropertyChanged}" />
                            </StackPanel>
                        </StackPanel>

                        <TextBlock
                            x:Name="lbDbFullPath"
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            Margin="8,-6,0,0"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource ImmHeaderSecondaryForeground}"
                            Text="{Binding DbInfo.DBFullPath, UpdateSourceTrigger=PropertyChanged}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding DbInfo.DBFullPath, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                </materialDesign:ColorZone>
        </materialDesign:DrawerHost>
            </Grid>

        <Border
            x:Name="OperationStatusBar"
            Grid.Row="1"
            Height="26"
            Background="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
            BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}"
            BorderThickness="0,1,0,0">
            <Grid Margin="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="4,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="{Binding StatusText}"
                    TextTrimming="None" />
                <ProgressBar
                    Grid.Column="1"
                    Height="4"
                    VerticalAlignment="Center"
                    Maximum="100"
                    Value="{Binding ProgressPercent, Mode=OneWay}"
                    Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button
                    Grid.Column="2"
                    Height="18"
                    MinWidth="0"
                    Margin="4,0,10,0"
                    Padding="7,0"
                    VerticalAlignment="Center"
                    Click="OperationStatusCancel_Click"
                    Content="中止"
                    FontSize="10"
                    Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Border>
        </Grid>

        <StackPanel
            x:Name="PlayerArea"
            Width="Auto"
            Height="Auto"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical"
            Visibility="Collapsed">
            <StackPanel.Effect>
                <DropShadowEffect
                    BlurRadius="2"
                    RenderingBias="Performance"
                    ShadowDepth="10"
                    Color="DarkGoldenrod" />
            </StackPanel.Effect>
            <Grid Width="900">
                <MediaElement
                    x:Name="uxPreviewImage"
                    Grid.Row="0"
                    Width="900"
                    Height="Auto"
                    LoadedBehavior="Manual"
                    UnloadedBehavior="Manual"
                    MediaEnded="UxPreviewImage_MediaEnded"
                    MediaFailed="UxPreviewImage_MediaFailed"
                    MediaOpened="UxPreviewImage_MediaOpened"
                    MouseDown="UxPreviewImage_MouseDown"
                    ScrubbingEnabled="True"
                    Stretch="Uniform" />
                <Image
                    x:Name="uxPreviewFallbackImage"
                    Width="900"
                    Height="Auto"
                    MouseDown="UxPreviewImage_MouseDown"
                    Stretch="Uniform"
                    Visibility="Collapsed" />
            </Grid>
            <StackPanel
                x:Name="PlayerController"
                Grid.Row="1"
                Width="Auto"
                Background="Black"
                Orientation="Horizontal"
                Visibility="Collapsed">
                <RepeatButton
                    Margin="5"
                    Background="{x:Null}"
                    BorderThickness="0"
                    Click="FR_Click"
                    Content="{materialDesign:PackIcon Kind=Rewind}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="戻す" />
                <Button
                    x:Name="PlayButton"
                    Margin="5"
                    Background="{x:Null}"
                    BorderThickness="0"
                    Click="Start_Click"
                    Content="{materialDesign:PackIcon Kind=Play}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="再生" />
                <RepeatButton
                    Margin="5"
                    Background="{x:Null}"
                    BorderThickness="0"
                    Click="FF_Click"
                    Content="{materialDesign:PackIcon Kind=FastForward}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="送る" />
                <Button
                    Margin="5"
                    Background="{x:Null}"
                    BorderThickness="0"
                    Click="Pause_Click"
                    Content="{materialDesign:PackIcon Kind=PauseBox}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="一時停止" />
                <Button
                    Margin="5"
                    Background="{x:Null}"
                    BorderThickness="0"
                    Click="Capture_Click"
                    Content="{materialDesign:PackIcon Kind=Camera}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="サムネイルの取得" />
                <Button
                    Margin="5"
                    Background="{x:Null}"
                    BorderThickness="0"
                    Click="AddBookmark_Click"
                    Content="{materialDesign:PackIcon Kind=BookmarkAdd}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="ブックマークの追加" />
                <Slider
                    x:Name="uxTimeSlider"
                    Width="300"
                    Height="20"
                    Margin="5"
                    DragEnter="UxTimeSlider_DragEnter"
                    DragLeave="UxTimeSlider_DragLeave"
                    IsSnapToTickEnabled="True"
                    SmallChange="2000"
                    ToolTip="再生位置"
                    ValueChanged="UxTimeSlider_ValueChanged"
                    Value="0" />
                <TextBlock
                    x:Name="uxTime"
                    Width="Auto"
                    Margin="20,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="White"
                    ToolTip="再生時刻" />
                <Slider
                    x:Name="uxVolumeSlider"
                    Width="50"
                    Height="20"
                    MinWidth="50"
                    Margin="20,0,0,0"
                    Maximum="1"
                    Minimum="0"
                    ToolTip="音量調整"
                    ValueChanged="UxVolumeSlider_ValueChanged"
                    Value="0.5" />
                <TextBlock
                    x:Name="uxVolume"
                    Width="40"
                    MinWidth="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="White"
                    TextAlignment="Right"
                    ToolTip="音量" />
                <Button
                    Width="30"
                    Height="30"
                    Margin="20,0,0,0"
                    Padding="0"
                    Background="{x:Null}"
                    BorderThickness="1"
                    Click="Stop_Click"
                    Content="{materialDesign:PackIcon Kind=Close}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="終了" />
            </StackPanel>
        </StackPanel>

        <Popup
            x:Name="RecentFileRemovePopup"
            AllowsTransparency="True"
            Placement="MousePoint"
            StaysOpen="False">
            <Border
                Padding="2"
                Background="{DynamicResource MaterialDesign.Brush.Background}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
                BorderThickness="1"
                SnapsToDevicePixels="True">
                <Button
                    Click="RemoveRecentFile_Click"
                    Content="最近使ったファイルから削除(_R)"
                    Style="{StaticResource RecentFileRemoveButtonStyle}" />
            </Border>
        </Popup>

        <Grid
            x:Name="LoadingOverlay"
            Panel.ZIndex="2000"
            Background="#99000000"
            Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar
                    Width="220"
                    Height="8"
                    IsIndeterminate="True" />
                <TextBlock
                    x:Name="LoadingOverlayMessage"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Foreground="White"
                    Text="読み込み中..." />
            </StackPanel>
        </Grid>
    </Grid>

</Window>
