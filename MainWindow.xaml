                            Content="/"
                            Foreground="White" />
                        <Label
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Content="{Binding MovieRecs.Count, UpdateSourceTrigger=PropertyChanged}"
                            Foreground="White" />
                        <Label
                            x:Name="lbDbFullPath"
                            Margin="20,0,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{Binding DbInfo.DBFullPath, UpdateSourceTrigger=PropertyChanged}"
                            Foreground="White" />
                    </VirtualizingStackPanel>
                </DockPanel>
            </materialDesign:ColorZone>
        </materialDesign:DrawerHost>
            </Grid>

        <Border
            x:Name="OperationStatusBar"
            Grid.Row="1"
            Height="26"
            Background="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
            BorderBrush="{DynamicResource MaterialDesign.Brush.Divider}"
            BorderThickness="0,1,0,0">
            <Grid Margin="4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="4,0,8,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Text="{Binding StatusText}"
                    TextTrimming="CharacterEllipsis" />
                <ProgressBar
                    Grid.Column="1"
                    Height="4"
                    VerticalAlignment="Center"
                    Maximum="100"
                    Value="{Binding ProgressPercent, Mode=OneWay}"
                    Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button
                    Grid.Column="2"
                    Height="18"
                    MinWidth="0"
                    Margin="4,0,10,0"
                    Padding="7,0"
                    VerticalAlignment="Center"
                    Click="OperationStatusCancel_Click"
                    Content="中止"
                    FontSize="10"
                    Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Border>
        </Grid>

        <StackPanel
            x:Name="PlayerArea"
            Width="Auto"
            Height="Auto"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Vertical"
            Visibility="Collapsed">
            <StackPanel.Effect>
                <DropShadowEffect
                    BlurRadius="2"
                    RenderingBias="Performance"
                    ShadowDepth="10"
                    Color="DarkGoldenrod" />
            </StackPanel.Effect>
            <Grid Width="900">
                <MediaElement
                    x:Name="uxPreviewImage"
                    Grid.Row="0"
                    Width="900"
                    Height="Auto"
                    LoadedBehavior="Manual"
                    UnloadedBehavior="Manual"
                    MediaEnded="UxPreviewImage_MediaEnded"
                    MediaFailed="UxPreviewImage_MediaFailed"
                    MediaOpened="UxPreviewImage_MediaOpened"
                    MouseDown="UxPreviewImage_MouseDown"
                    ScrubbingEnabled="True"
                    Stretch="Uniform" />
                <Image
                    x:Name="uxPreviewFallbackImage"
                    Width="900"
                    Height="Auto"
                    MouseDown="UxPreviewImage_MouseDown"
                    Stretch="Uniform"
                    Visibility="Collapsed" />
            </Grid>
            <StackPanel
                x:Name="PlayerController"
                Grid.Row="1"
                Width="Auto"
                Background="Black"
                Orientation="Horizontal"
                Visibility="Collapsed">
                <RepeatButton
                    Margin="5"
                    Background="{x:Null}"
                    BorderThickness="0"
                    Click="FR_Click"
                    Content="{materialDesign:PackIcon Kind=Rewind}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="戻す" />
                <Button
                    x:Name="PlayButton"
                    Margin="5"
                    Background="{x:Null}"
                    BorderThickness="0"
                    Click="Start_Click"
                    Content="{materialDesign:PackIcon Kind=Play}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="再生" />
                <RepeatButton
                    Margin="5"
                    Background="{x:Null}"
                    BorderThickness="0"
                    Click="FF_Click"
                    Content="{materialDesign:PackIcon Kind=FastForward}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="送る" />
                <Button
                    Margin="5"
                    Background="{x:Null}"
                    BorderThickness="0"
                    Click="Pause_Click"
                    Content="{materialDesign:PackIcon Kind=PauseBox}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="一時停止" />
                <Button
                    Margin="5"
                    Background="{x:Null}"
                    BorderThickness="0"
                    Click="Capture_Click"
                    Content="{materialDesign:PackIcon Kind=Camera}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="サムネイルの取得" />
                <Button
                    Margin="5"
                    Background="{x:Null}"
                    BorderThickness="0"
                    Click="AddBookmark_Click"
                    Content="{materialDesign:PackIcon Kind=BookmarkAdd}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="ブックマークの追加" />
                <Slider
                    x:Name="uxTimeSlider"
                    Width="300"
                    Height="20"
                    Margin="5"
                    DragEnter="UxTimeSlider_DragEnter"
                    DragLeave="UxTimeSlider_DragLeave"
                    IsSnapToTickEnabled="True"
                    SmallChange="2000"
                    ToolTip="再生位置"
                    ValueChanged="UxTimeSlider_ValueChanged"
                    Value="0" />
                <TextBlock
                    x:Name="uxTime"
                    Width="Auto"
                    Margin="20,0,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="White"
                    ToolTip="再生時刻" />
                <Slider
                    x:Name="uxVolumeSlider"
                    Width="50"
                    Height="20"
                    MinWidth="50"
                    Margin="20,0,0,0"
                    Maximum="1"
                    Minimum="0"
                    ToolTip="音量調整"
                    ValueChanged="UxVolumeSlider_ValueChanged"
                    Value="0.5" />
                <TextBlock
                    x:Name="uxVolume"
                    Width="40"
                    MinWidth="40"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="White"
                    TextAlignment="Right"
                    ToolTip="音量" />
                <Button
                    Width="30"
                    Height="30"
                    Margin="20,0,0,0"
                    Padding="0"
                    Background="{x:Null}"
                    BorderThickness="1"
                    Click="Stop_Click"
                    Content="{materialDesign:PackIcon Kind=Close}"
                    Style="{StaticResource MaterialDesignIconButton}"
                    ToolTip="終了" />
            </StackPanel>
        </StackPanel>

        <Popup
            x:Name="RecentFileRemovePopup"
            AllowsTransparency="True"
            Placement="MousePoint"
            StaysOpen="False">
            <Border
                Padding="2"
                Background="{DynamicResource MaterialDesign.Brush.Background}"
                BorderBrush="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"
                BorderThickness="1"
                SnapsToDevicePixels="True">
                <Button
                    Click="RemoveRecentFile_Click"
                    Content="最近使ったファイルから削除(_R)"
                    Style="{StaticResource RecentFileRemoveButtonStyle}" />
            </Border>
        </Popup>

        <Grid
            x:Name="LoadingOverlay"
            Panel.ZIndex="2000"
            Background="#99000000"
            Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar
                    Width="220"
                    Height="8"
                    IsIndeterminate="True" />
                <TextBlock
                    x:Name="LoadingOverlayMessage"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    Foreground="White"
                    Text="読み込み中..." />
            </StackPanel>
        </Grid>
    </Grid>

</Window>
