<Window
    x:Class="IndigoMovieManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ModelView="clr-namespace:IndigoMovieManager.ModelViews"
    xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
    xmlns:c="clr-namespace:IndigoMovieManager.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:IndigoMovieManager"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:view="clr-namespace:IndigoMovieManager.UserControls"
    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
    x:Name="window"
    Title="Indigo Movie Manager"
    Width="800"
    Height="Auto"
    mc:Ignorable="d">

    <Window.Resources>
        <c:FileSizeConverter x:Key="FileSizeConverter" />
        <c:NoLockImageConverter x:Key="noLockImageConverter" />
        <!--  BoolToVisibilityConverter を追加  -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="SearchHistoryRemoveButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#99000000" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="11"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#22000000" />
                                <Setter Property="Foreground" Value="#DD000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="SearchHistoryItemContextMenu">
            <MenuItem Click="SearchHistoryDeleteMenuItem_Click" Header="この履歴を削除" />
        </ContextMenu>

        <DataTemplate x:Key="SearchHistoryItemTemplate">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    Margin="2,0,4,0"
                    VerticalAlignment="Center"
                    Text="{Binding Find_Text}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    Grid.Column="1"
                    Click="SearchHistoryDeleteButton_Click"
                    Content="×"
                    Focusable="False"
                    IsTabStop="False"
                    Style="{StaticResource SearchHistoryRemoveButtonStyle}"
                    ToolTip="この履歴を削除" />
            </Grid>
        </DataTemplate>

        <Style x:Key="RecentFileRemoveButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="NavigationDrawerPrimaryItemTemplate" DataType="{x:Type local:NavigationDrawerItem}">
            <DockPanel Margin="0,0,1,0">
                <materialDesign:PackIcon
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                    Kind="{Binding IconKind}" />
                <TextBlock
                    Margin="10,0,10,0"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                    Text="{Binding Text}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Text}" />
            </DockPanel>
        </DataTemplate>

        <DataTemplate x:Key="NavigationDrawerNestedItemTemplate" DataType="{x:Type local:NavigationDrawerItem}">
            <DockPanel Margin="1,0,1,0">
                <materialDesign:PackIcon
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                    Kind="{Binding IconKind}" />
                <TextBlock
                    Margin="10,4,10,2"
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                    Text="{Binding Text}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Text}" />
            </DockPanel>
        </DataTemplate>

        <Style x:Key="NavigationDrawerListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ItemTemplate" Value="{StaticResource NavigationDrawerPrimaryItemTemplate}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>

        <Style
            x:Key="NavigationDrawerNestedListBoxStyle"
            BasedOn="{StaticResource NavigationDrawerListBoxStyle}"
            TargetType="ListBox">
            <Setter Property="ItemTemplate" Value="{StaticResource NavigationDrawerNestedItemTemplate}" />
        </Style>

        <Style x:Key="NavigationDrawerListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,4,0,6" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsEnabled" Value="{Binding IsEnabled, FallbackValue=True}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Border"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="Transparent" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Border" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="NavigationDrawerRecentListBoxItemStyle"
            BasedOn="{StaticResource NavigationDrawerListBoxItemStyle}"
            TargetType="ListBoxItem" />

        <Style x:Key="NavigationDrawerSectionChevronStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="19" />
            <Setter Property="Height" Value="19" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
            <Setter Property="Kind" Value="ChevronRight" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                    <Setter Property="Kind" Value="ChevronDown" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavigationDrawerSectionHeaderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="IsChecked" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Border"
                            Padding="4,4,0,6"
                            Background="{TemplateBinding Background}"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationDrawerSectionHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,4,10,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
        </Style>

        <ContextMenu x:Key="menuContext" FontSize="10" Opened="MenuContext_Opened">
            <MenuItem
                x:Name="PlayDefault"
                Click="PlayMovie_Click"
                Header="プレイヤーから開く(_E)"
                Icon="{materialDesign:PackIcon Kind=MoviePlay}"
                InputGestureText="ENTER">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                x:Name="PlayFromThumb"
                Click="PlayMovie_Click"
                Header="サムネイルから開く(_H)"
                Icon="{materialDesign:PackIcon Kind=MoviePlay}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator />
            <MenuItem
                x:Name="TagEdit"
                Click="TagEdit_Click"
                Header="タグ編集(_T)"
                Icon="{materialDesign:PackIcon Kind=Edit}"
                InputGestureText="F6">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                x:Name="TagAdd"
                Click="TagAdd_Click"
                Header="タグ追加(_A)"
                Icon="{materialDesign:PackIcon Kind=AttachmentAdd}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                x:Name="TagDelete"
                Click="TagDelete_Click"
                Header="タグ削除(_V)"
                Icon="{materialDesign:PackIcon Kind=RemoveBox}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                x:Name="TagCopy"
                Click="TagCopy_Click"
                Header="タグコピー(_C)"
                Icon="{materialDesign:PackIcon Kind=ContentCopy}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                x:Name="TagPaste"
                Click="TagPaste_Click"
                Header="タグ貼り付け(_V)"
                Icon="{materialDesign:PackIcon Kind=ContentPaste}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                x:Name="ScorePlus"
                Click="MenuScore_Click"
                Header="スコア +1 (_A)"
                Icon="{materialDesign:PackIcon Kind=Plus}"
                InputGestureText="+">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                x:Name="ScoreMinus"
                Click="MenuScore_Click"
                Header="スコア -1 (_S)"
                Icon="{materialDesign:PackIcon Kind=Minus}"
                InputGestureText="-">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator />
            <MenuItem
                Click="CreateThumb_EqualInterval"
                Header="等間隔サムネイル作成(_I)"
                Icon="{materialDesign:PackIcon Kind=Create}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <!--- ランダムサムネイルと画像からはなしにした
                                                <MenuItem Header="ランダムサムネイル作成(_R)" Icon="{materialDesign:PackIcon Kind=CreateOutline}" />
                                                <MenuItem Header="画像からサムネイル作成(_P)" Icon="{materialDesign:PackIcon Kind=Image}" />
            -->
            <MenuItem
                x:Name="ManualThumbnail"
                Click="ManualThumbnail_Click"
                Header="マニュアルサムネイル作成(_U)"
                Icon="{materialDesign:PackIcon Kind=Manufacturing}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                x:Name="RefreshFileInfo"
                Click="RefreshFileInfo_Click"
                Header="ファイル情報再取得(_F)"
                Icon="{materialDesign:PackIcon Kind=InformationOutline}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator />
            <MenuItem
                x:Name="DeleteMovie"
                Click="DeleteMovieRecord_Click"
                Header="登録から削除(_D)"
                Icon="{materialDesign:PackIcon Kind=Delete}"
                InputGestureText="DELETE">

                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                x:Name="FileCopy"
                Click="MenuCopyAndMove_Click"
                Header="ファイルをコピー(_C)"
                Icon="{materialDesign:PackIcon Kind=ContentCopy}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                x:Name="FileMove"
                Click="MenuCopyAndMove_Click"
                Header="ファイルを移動(_M)"
                Icon="{materialDesign:PackIcon Kind=MoveToInbox}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                x:Name="DeleteFile"
                Click="DeleteMovieRecord_Click"
                Header="ファイルを削除(_L)"
                Icon="{materialDesign:PackIcon Kind=RemoveCircle}">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem
                x:Name="RenameFile"
                Click="RenameFile_Click"
                Header="ファイル名変更(_N)"
                Icon="{materialDesign:PackIcon Kind=Rename}"
                InputGestureText="F2">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator />
            <MenuItem
                Click="OpenParentFolder_Click"
                Header="親フォルダを開く(_F)"
                Icon="{materialDesign:PackIcon Kind=FolderOpen}"
                InputGestureText="F12">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="Padding" Value="1" />
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <!-- この辺はウィンドウ作らないといけないので劣後だろうな。
                                                <MenuItem Header="プロパティ(_P)" Icon="{materialDesign:PackIcon Kind=PropertyTag}" InputGestureText="P">
                                                    <MenuItem.Style>
                                                        <Style TargetType="MenuItem">
                                                            <Setter Property="Padding" Value="1" />
                                                        </Style>
                                                    </MenuItem.Style>
                                                </MenuItem>
            -->
        </ContextMenu>

    </Window.Resources>

    <Window.Background>
        <SolidColorBrush Color="{DynamicResource {x:Static SystemColors.ControlColorKey}}" />
    </Window.Background>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
        <avalonDock:DockingManager x:Name="uxDockingManager" Margin="0,70,0,0">
            <avalonDock:DockingManager.Theme>
                <avalonDock:Vs2013LightTheme />
            </avalonDock:DockingManager.Theme>
            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Vertical">
                    <avalonDock:LayoutPanel
                        CanDock="False"
                        CanRepositionItems="False"
                        Orientation="Horizontal">
                        <avalonDock:LayoutDocumentPane
                            x:Name="uxDocumentPane"
                            CanRepositionItems="False"
                            ShowHeader="False">
                            <!--  ドキュメント  ★ここから  -->
                            <avalonDock:LayoutDocument Title="Document1" ContentId="Document1">
                                <TabControl
                                    x:Name="Tabs"
                                    Margin="0,0,0,0"
                                    PreviewKeyDown="Tab_PreviewKeyDown"
                                    SelectionChanged="Tabs_SelectionChangedAsync">

                                    <TabItem
                                        x:Name="TabSmall"
                                        Background="DarkBlue"
                                        Header="Small"
                                        Tag="120x90x3x1">
                                        <ListView
                                            x:Name="SmallList"
                                            Height="Auto"
                                            ItemsSource="{Binding MovieRecs, UpdateSourceTrigger=PropertyChanged}"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            ScrollViewer.IsDeferredScrollingEnabled="True"
                                            SelectionChanged="List_SelectionChanged"
                                            SelectionMode="Extended"
                                            VirtualizingPanel.IsVirtualizing="True"
                                            VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <vwp:VirtualizingWrapPanel
                                                        Orientation="Horizontal"
                                                        StretchItems="True"
                                                        VirtualizingPanel.IsVirtualizing="True"
                                                        VirtualizingPanel.VirtualizationMode="Recycling" />
                                                </ItemsPanelTemplate>
                                            </ListView.ItemsPanel>

                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <!--  内容更新時のバインドエラー回避のおまじない。  -->
                                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                                    <!--  ここを追加: ListViewItem内のどこをクリックしても選択状態にする  -->
                                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="SmallListItem_PreviewMouseLeftButtonDown" />
                                                </Style>
                                            </ListView.ItemContainerStyle>

                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <VirtualizingStackPanel
                                                        Height="Auto"
                                                        Orientation="Vertical"
                                                        ScrollViewer.IsDeferredScrollingEnabled="true"
                                                        VirtualizingPanel.IsVirtualizing="True"
                                                        VirtualizingPanel.VirtualizationMode="Recycling">
                                                        <VirtualizingStackPanel
                                                            Orientation="Horizontal"
                                                            ScrollViewer.IsDeferredScrollingEnabled="true"
                                                            VirtualizingPanel.IsVirtualizing="True"
                                                            VirtualizingPanel.VirtualizationMode="Recycling">
                                                            <Label
                                                                Width="360"
                                                                Height="Auto"
                                                                Background="Black"
                                                                MouseDoubleClick="PlayMovie_Click"
                                                                MouseDown="Label_MouseDown">
                                                                <Image
                                                                    ContextMenu="{StaticResource menuContext}"
                                                                    PreviewMouseRightButtonDown="ThumbnailImage_PreviewMouseRightButtonDown"
                                                                    Stretch="Uniform"
                                                                    VirtualizingPanel.IsVirtualizing="True"
                                                                    VirtualizingPanel.ScrollUnit="Pixel"
                                                                    VirtualizingPanel.VirtualizationMode="Recycling">
                                                                    <Image.Source>
                                                                        <!--
                                                                            Source="{Binding ThumbPathSmall, Converter={StaticResource noLockImageConverter}, ConverterParameter={Binding IsExists}, UpdateSourceTrigger=PropertyChanged}"
                                                                        -->
                                                                        <c:ConverterBindableParameter
                                                                            Binding="{Binding ThumbPathSmall}"
                                                                            Converter="{StaticResource noLockImageConverter}"
                                                                            ConverterParameter="{Binding IsExists}" />
                                                                    </Image.Source>
                                                                </Image>
                                                            </Label>

                                                            <view:SmallDetailControl />

                                                        </VirtualizingStackPanel>

                                                        <ItemsControl
                                                            Height="Auto"
                                                            ItemsSource="{Binding Tag, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                                                            ScrollViewer.CanContentScroll="True"
                                                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                            ScrollViewer.IsDeferredScrollingEnabled="True"
                                                            VirtualizingPanel.IsContainerVirtualizable="True"
                                                            VirtualizingPanel.IsVirtualizing="True"
                                                            VirtualizingPanel.ScrollUnit="Pixel"
                                                            VirtualizingPanel.VirtualizationMode="Recycling">

                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <view:TagControl DataContext="{Binding}" />
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>

                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel
                                                                        Width="650"
                                                                        Height="Auto"
                                                                        MinHeight="62"
                                                                        MaxHeight="110"
                                                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                        VirtualizingPanel.IsVirtualizing="True"
                                                                        VirtualizingPanel.VirtualizationMode="Recycling" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>

                                                        </ItemsControl>
                                                    </VirtualizingStackPanel>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </TabItem>

                                    <TabItem
                                        x:Name="TabBig"
                                        Background="DarkBlue"
                                        Header="Big"
                                        Tag="200x150x3x1">
                                        <ListView
                                            x:Name="BigList"
                                            ItemsSource="{Binding MovieRecs, UpdateSourceTrigger=PropertyChanged}"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            ScrollViewer.IsDeferredScrollingEnabled="True"
                                            SelectionChanged="List_SelectionChanged"
                                            SelectionMode="Extended"
                                            VirtualizingPanel.IsVirtualizing="True"
                                            VirtualizingPanel.ScrollUnit="Pixel"
                                            VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListView.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <vwp:VirtualizingWrapPanel
                                                        Orientation="Horizontal"
                                                        StretchItems="True"
                                                        VirtualizingPanel.IsVirtualizing="True"
                                                        VirtualizingPanel.ScrollUnit="Pixel"
                                                        VirtualizingPanel.VirtualizationMode="Recycling" />
                                                </ItemsPanelTemplate>
                                            </ListView.ItemsPanel>

                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="ListViewItem">
                                                    <!--  内容更新時のバインドエラー回避のおまじない。  -->
                                                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                                                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                                                    <!--  ここを追加: ListViewItem内のどこをクリックしても選択状態にする  -->
                                                    <EventSetter Event="PreviewMouseLeftButtonDown" Handler="BigListItem_PreviewMouseLeftButtonDown" />
                                                </Style>
                                            </ListView.ItemContainerStyle>

                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <VirtualizingStackPanel
                                                        Orientation="Horizontal"
                                                        ScrollViewer.IsDeferredScrollingEnabled="true"
                                                        VirtualizingPanel.IsVirtualizing="True"
                                                        VirtualizingPanel.VirtualizationMode="Recycling">
                                                        <VirtualizingStackPanel
                                                            Orientation="Vertical"
                                                            VirtualizingPanel.IsVirtualizing="True"
                                                            VirtualizingPanel.ScrollUnit="Pixel"
                                                            VirtualizingPanel.VirtualizationMode="Recycling">

                                                            <view:BigTitleControl DataContext="{Binding}" />

                                                            <Label
                                                                Width="600"
                                                                Height="150"
                                                                MouseDoubleClick="PlayMovie_Click"
                                                                MouseDown="Label_MouseDown">
                                                                <Image
                                                                    ContextMenu="{StaticResource menuContext}"
                                                                    PreviewMouseRightButtonDown="ThumbnailImage_PreviewMouseRightButtonDown"
                                                                    Stretch="Uniform"
                                                                    VirtualizingPanel.IsVirtualizing="True"
                                                                    VirtualizingPanel.ScrollUnit="Pixel"
