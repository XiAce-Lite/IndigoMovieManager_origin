<Window
    x:Class="IndigoMovieManager.SkinMaintenanceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:IndigoMovieManager.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="WPFスキン編集"
    Width="1040"
    Height="720"
    MinWidth="820"
    MinHeight="520"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource MaterialDesign.Brush.Background}"
    Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="ColorPickButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="ToolTip" Value="色を選択" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border
            DockPanel.Dock="Top"
            Padding="10,8"
            Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
            <DockPanel>
                <StackPanel
                    DockPanel.Dock="Right"
                    Orientation="Horizontal">
                    <Button
                        x:Name="SaveButton"
                        Margin="0,0,6,0"
                        Click="SaveButton_Click"
                        Content="保存(_S)" />
                    <Button
                        x:Name="SaveAsButton"
                        Margin="0,0,6,0"
                        Click="SaveAsButton_Click"
                        Content="名前を付けて保存(_A)" />
                    <Button
                        x:Name="DeleteButton"
                        Margin="0,0,6,0"
                        Click="DeleteButton_Click"
                        Content="ゴミ箱へ削除(_D)" />
                    <Button
                        Click="CloseButton_Click"
                        Content="閉じる(_C)"
                        IsCancel="True" />
                </StackPanel>
                <StackPanel>
                    <TextBlock
                        x:Name="StatusTitle"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="WPFスキン" />
                    <TextBlock
                        x:Name="StatusBanner"
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*" MinWidth="300" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <ScrollViewer
                Grid.Column="0"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,6,0">
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="基本" />
                    <TextBox
                        x:Name="DisplayNameBox"
                        Margin="0,0,0,6"
                        materialDesign:HintAssist.Hint="表示名 (name)"
                        materialDesign:HintAssist.IsFloating="True"
                        materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                        TextChanged="Field_Changed" />
                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <ComboBox
                            x:Name="TypeCombo"
                            Margin="0,0,4,0"
                            materialDesign:HintAssist.Hint="type"
                            materialDesign:HintAssist.IsFloating="True"
                            materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                            SelectionChanged="Field_Changed">
                            <ComboBoxItem Content="card" IsSelected="True" />
                            <ComboBoxItem Content="list" />
                        </ComboBox>
                        <ComboBox
                            x:Name="ColorProfileCombo"
                            Margin="4,0,0,0"
                            materialDesign:HintAssist.Hint="colorProfile"
                            materialDesign:HintAssist.IsFloating="True"
                            materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                            SelectionChanged="Field_Changed">
                            <ComboBoxItem Content="（追従）" Tag="" IsSelected="True" />
                            <ComboBoxItem Content="light" Tag="light" />
                            <ComboBoxItem Content="dark" Tag="dark" />
                        </ComboBox>
                    </UniformGrid>

                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="サーフェス / カード" />
                    <DockPanel Margin="0,0,0,6">
                        <Button
                            Style="{StaticResource ColorPickButton}"
                            DockPanel.Dock="Right"
                            Click="SurfaceBackgroundPick_Click">
                            <materialDesign:PackIcon Kind="Palette" Width="14" Height="14" />
                        </Button>
                        <TextBox
                            x:Name="SurfaceBackgroundBox"
                            materialDesign:HintAssist.Hint="surface.background"
                            materialDesign:HintAssist.IsFloating="True"
                            materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                            TextChanged="Field_Changed" />
                    </DockPanel>
                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="11"
                        Opacity="0.75"
                        TextWrapping="Wrap"
                        Text="カード幅・高さは layout 依存のため UI 非表示。変更は skin.json を直接編集してください。" />
                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <controls:IntegerSpinBox
                            x:Name="CardPaddingSpin"
                            Margin="0,0,4,0"
                            Hint="card.padding"
                            Minimum="0"
                            Maximum="200"
                            ValueChanged="Spin_Changed" />
                        <DockPanel Margin="4,0,0,0">
                            <Button
                                Style="{StaticResource ColorPickButton}"
                                DockPanel.Dock="Right"
                                Click="CardBackgroundPick_Click">
                                <materialDesign:PackIcon Kind="Palette" Width="14" Height="14" />
                            </Button>
                            <TextBox
                                x:Name="CardBackgroundBox"
                                materialDesign:HintAssist.Hint="card.background"
                                materialDesign:HintAssist.IsFloating="True"
                                materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                                TextChanged="Field_Changed" />
                        </DockPanel>
                    </UniformGrid>
                    <CheckBox
                        x:Name="CardStretchCheck"
                        Margin="0,0,0,10"
                        Content="card.stretch（幅追従）"
                        Checked="Field_Changed"
                        Unchecked="Field_Changed" />

                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="サムネイル" />
                    <ComboBox
                        x:Name="ThumbAspectCombo"
                        Margin="0,0,0,6"
                        materialDesign:HintAssist.Hint="縦横比"
                        materialDesign:HintAssist.IsFloating="True"
                        materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                        SelectionChanged="ThumbAspect_Changed" />
                    <UniformGrid Columns="2" Margin="0,0,0,6">
                        <controls:IntegerSpinBox
                            x:Name="ThumbWidthSpin"
                            Margin="0,0,4,0"
                            Hint="幅 (px)"
                            Minimum="1"
                            Maximum="4000"
                            ValueChanged="ThumbSpin_Changed" />
                        <controls:IntegerSpinBox
                            x:Name="ThumbHeightSpin"
                            Margin="4,0,0,0"
                            Hint="高さ (px)"
                            Minimum="1"
                            Maximum="4000"
                            ValueChanged="ThumbSpin_Changed" />
                    </UniformGrid>
                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <ComboBox
                            x:Name="ThumbColumnsCombo"
                            Margin="0,0,4,0"
                            materialDesign:HintAssist.Hint="columns"
                            materialDesign:HintAssist.IsFloating="True"
                            materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                            SelectionChanged="Field_Changed" />
                        <ComboBox
                            x:Name="ThumbRowsCombo"
                            Margin="4,0,0,0"
                            materialDesign:HintAssist.Hint="rows"
                            materialDesign:HintAssist.IsFloating="True"
                            materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                            SelectionChanged="Field_Changed" />
                    </UniformGrid>

                    <TextBlock
                        Margin="0,0,0,6"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Text="styles" />
                    <TextBlock
                        Margin="0,0,0,4"
                        FontSize="11"
                        Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                        Text="layout は編集しません。styles の見た目のみ。"
                        TextWrapping="Wrap" />
                    <DockPanel Margin="0,0,0,6" LastChildFill="True">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <UniformGrid Columns="2" Margin="0,0,0,6">
                                <controls:IntegerSpinBox
                                    x:Name="StyleFontSizeSpin"
                                    Margin="0,0,4,0"
                                    Hint="fontSize"
                                    Minimum="6"
                                    Maximum="72"
                                    ValueChanged="StyleSpin_Changed" />
                                <ComboBox
                                    x:Name="StyleFontFamilyCombo"
                                    Margin="4,0,0,0"
                                    materialDesign:HintAssist.Hint="fontFamily"
                                    materialDesign:HintAssist.IsFloating="True"
                                    materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                                    SelectionChanged="StyleField_Changed" />
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="0,0,0,6">
                                <DockPanel Margin="0,0,4,0">
                                    <Button
                                        Style="{StaticResource ColorPickButton}"
                                        DockPanel.Dock="Right"
                                        Click="StyleForegroundPick_Click">
                                        <materialDesign:PackIcon Kind="Palette" Width="14" Height="14" />
                                    </Button>
                                    <TextBox
                                        x:Name="StyleForegroundBox"
                                        materialDesign:HintAssist.Hint="foreground"
                                        materialDesign:HintAssist.IsFloating="True"
                                        materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                                        TextChanged="StyleField_Changed" />
                                </DockPanel>
                                <DockPanel Margin="4,0,0,0">
                                    <Button
                                        Style="{StaticResource ColorPickButton}"
                                        DockPanel.Dock="Right"
                                        Click="StyleBackgroundPick_Click">
                                        <materialDesign:PackIcon Kind="Palette" Width="14" Height="14" />
                                    </Button>
                                    <TextBox
                                        x:Name="StyleBackgroundBox"
                                        materialDesign:HintAssist.Hint="background"
                                        materialDesign:HintAssist.IsFloating="True"
                                        materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                                        TextChanged="StyleField_Changed" />
                                </DockPanel>
                            </UniformGrid>
                            <UniformGrid Columns="2" Margin="0,0,0,6">
                                <ComboBox
                                    x:Name="StyleAlignCombo"
                                    Margin="0,0,4,0"
                                    materialDesign:HintAssist.Hint="align"
                                    materialDesign:HintAssist.IsFloating="True"
                                    materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                                    SelectionChanged="StyleField_Changed">
                                    <ComboBoxItem Content="left" IsSelected="True" />
                                    <ComboBoxItem Content="center" />
                                    <ComboBoxItem Content="right" />
                                </ComboBox>
                                <StackPanel Margin="4,8,0,0" Orientation="Horizontal">
                                    <CheckBox
                                        x:Name="StyleBoldCheck"
                                        Margin="0,0,10,0"
                                        Content="bold"
                                        Checked="StyleField_Changed"
                                        Unchecked="StyleField_Changed" />
                                    <CheckBox
                                        x:Name="StyleItalicCheck"
                                        Margin="0,0,10,0"
                                        Content="italic"
                                        Checked="StyleField_Changed"
                                        Unchecked="StyleField_Changed" />
                                    <CheckBox
                                        x:Name="StyleWrapCheck"
                                        Content="wrap"
                                        Checked="StyleField_Changed"
                                        Unchecked="StyleField_Changed" />
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                        <ListBox
                            x:Name="StyleList"
                            Height="100"
                            SelectionChanged="StyleList_SelectionChanged" />
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Stretch"
                Background="Transparent" />

            <DockPanel Grid.Column="2">
                <TextBlock
                    DockPanel.Dock="Top"
                    Margin="0,0,0,6"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="プレビュー" />
                <Border
                    BorderBrush="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <ListView
                        x:Name="PreviewList"
                        BorderThickness="0"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
