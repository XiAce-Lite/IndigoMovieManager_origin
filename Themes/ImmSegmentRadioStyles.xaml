<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:IndigoMovieManager.Controls">

    <!--  ヘッダー（PrimaryDark / Dark ColorZone）用セグメント  -->
    <Style x:Key="HeaderSegmentRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource ImmHeaderSegmentForeground}" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="controls:SegmentRadioAssist.CornerRadius" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        ClipToBounds="True"
                        CornerRadius="{TemplateBinding controls:SegmentRadioAssist.CornerRadius}">
                        <Grid SnapsToDevicePixels="True">
                            <Border
                                x:Name="Surface"
                                Padding="{TemplateBinding Padding}"
                                Background="{DynamicResource ImmHeaderSegmentBackground}"
                                CornerRadius="{TemplateBinding controls:SegmentRadioAssist.CornerRadius}">
                                <ContentPresenter
                                    x:Name="Content"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="True" />
                            </Border>
                            <Border
                                x:Name="TopEdge"
                                Height="1"
                                VerticalAlignment="Top"
                                Background="{DynamicResource ImmHeaderSegmentRaisedHighlight}" />
                            <Border
                                x:Name="LeftEdge"
                                Width="1"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource ImmHeaderSegmentRaisedHighlight}" />
                            <Border
                                x:Name="BottomEdge"
                                Height="1"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource ImmHeaderSegmentRaisedShadow}" />
                            <Border
                                x:Name="RightEdge"
                                Width="1"
                                HorizontalAlignment="Right"
                                Background="{DynamicResource ImmHeaderSegmentRaisedShadow}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ImmHeaderSegmentHoverBackground}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ImmHeaderSegmentCheckedBackground}" />
                            <Setter TargetName="Surface" Property="Margin" Value="1,1,0,0" />
                            <Setter TargetName="TopEdge" Property="Background" Value="{DynamicResource ImmHeaderSegmentInsetShadow}" />
                            <Setter TargetName="LeftEdge" Property="Background" Value="{DynamicResource ImmHeaderSegmentInsetShadow}" />
                            <Setter TargetName="BottomEdge" Property="Background" Value="{DynamicResource ImmHeaderSegmentInsetHighlight}" />
                            <Setter TargetName="RightEdge" Property="Background" Value="{DynamicResource ImmHeaderSegmentInsetHighlight}" />
                            <Setter TargetName="Content" Property="TextElement.FontWeight" Value="Bold" />
                            <Setter Property="Foreground" Value="{DynamicResource ImmHeaderSegmentCheckedForeground}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ImmHeaderSegmentCheckedBackground}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  共通設定など通常背景用セグメント  -->
