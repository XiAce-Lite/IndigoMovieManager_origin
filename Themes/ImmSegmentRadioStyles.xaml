                            </Border>
                            <Border
                                x:Name="TopEdge"
                                Height="1"
                                VerticalAlignment="Top"
                                Background="{DynamicResource ImmSettingsSegmentRaisedHighlight}" />
                            <Border
                                x:Name="LeftEdge"
                                Width="1"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource ImmSettingsSegmentRaisedHighlight}" />
                            <Border
                                x:Name="BottomEdge"
                                Height="1"
                                VerticalAlignment="Bottom"
                                Background="{DynamicResource ImmSettingsSegmentRaisedShadow}" />
                            <Border
                                x:Name="RightEdge"
                                Width="1"
                                HorizontalAlignment="Right"
                                Background="{DynamicResource ImmSettingsSegmentRaisedShadow}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ImmSettingsSegmentHoverBackground}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ImmSettingsSegmentCheckedBackground}" />
                            <Setter TargetName="Surface" Property="Margin" Value="1,1,0,0" />
                            <Setter TargetName="TopEdge" Property="Background" Value="{DynamicResource ImmSettingsSegmentInsetShadow}" />
                            <Setter TargetName="LeftEdge" Property="Background" Value="{DynamicResource ImmSettingsSegmentInsetShadow}" />
                            <Setter TargetName="BottomEdge" Property="Background" Value="{DynamicResource ImmSettingsSegmentInsetHighlight}" />
                            <Setter TargetName="RightEdge" Property="Background" Value="{DynamicResource ImmSettingsSegmentInsetHighlight}" />
                            <Setter TargetName="Content" Property="TextElement.FontWeight" Value="Bold" />
                            <Setter Property="Foreground" Value="{DynamicResource ImmSettingsSegmentCheckedForeground}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsChecked" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ImmSettingsSegmentCheckedBackground}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
