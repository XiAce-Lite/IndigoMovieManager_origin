<Window
    x:Class="IndigoMovieManager.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="個別設定"
    Width="800"
    SizeToContent="Height"
    MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Slider.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <materialDesign:ColorZone>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10" Orientation="Vertical">
                <Button
                    x:Name="BtnReturn"
                    Margin="10,6,0,6"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Click="BtnReturn_Click"
                    Content="戻る(_R)"
                    FontWeight="Normal" />

                <StackPanel Orientation="Horizontal">
                    <Label
                        Width="170"
                        Margin="5"
                        Content="サムネイルフォルダー"
                        FontSize="14" />
                    <TextBox
                        x:Name="ThumbFolder"
                        Width="520"
                        Margin="5"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        FontSize="14"
                        IsReadOnly="True"
                        Text="{Binding ThumbFolder}"
                        ToolTip="{Binding ThumbFolder}" />
                    <Button
                        x:Name="OpenThumbFolder"
                        Width="30"
                        Height="30"
                        Click="OpenFolderDialog_Click"
                        Content="{materialDesign:PackIcon Kind=FolderOpen}"
                        Style="{StaticResource MaterialDesignIconButton}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label
                        Width="170"
                        Margin="5"
                        Content="ブックマークフォルダー"
                        FontSize="14" />
                    <TextBox
                        x:Name="BookmarkFolder"
                        Width="520"
                        Margin="5"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        FontSize="14"
                        IsReadOnly="True"
                        Text="{Binding BookmarkFolder}"
                        ToolTip="{Binding BookmarkFolder}" />
                    <Button
                        x:Name="OpenBookmarkFolder"
                        Width="30"
                        Height="30"
                        Click="OpenFolderDialog_Click"
                        Content="{materialDesign:PackIcon Kind=FolderOpen}"
                        Style="{StaticResource MaterialDesignIconButton}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label
                        Width="170"
                        Margin="5"
                        Content="再生プレイヤー"
                        FontSize="14" />
                    <TextBox
                        x:Name="PlayerPrg"
                        Width="520"
                        Margin="5"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        FontSize="14"
                        IsReadOnly="True"
                        Text="{Binding PlayerPrg}"
                        ToolTip="{Binding PlayerPrg}" />
                    <Button
                        x:Name="OpenDialogPlayer"
                        Width="30"
                        Height="30"
                        Click="OpenDialogPlayer_Click"
                        Content="{materialDesign:PackIcon Kind=FolderOpen}"
                        Style="{StaticResource MaterialDesignIconButton}" />

                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label
                        Width="170"
                        Margin="5"
                        Content="再生プレイヤーパラメータ"
                        FontSize="14"
                        ToolTip="&lt;ms&gt;と&lt;file&gt;の置換のみ対応" />
                    <ComboBox
                        x:Name="PlayerParam"
                        Width="520"
                        Margin="5"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        FontSize="14"
                        IsEditable="True"
                        Text="{Binding PlayerParam}"
                        ToolTip="&lt;ms&gt;と&lt;file&gt;の置換のみ対応" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label
                        Width="170"
                        Margin="5"
                        Content="検索履歴の保持数"
                        FontSize="14" />
                    <TextBlock
                        x:Name="KeepHistory"
                        Width="50"
                        Margin="5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="{Binding KeepHistory}" />
                    <Slider
                        x:Name="slider"
                        Width="450"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Maximum="100"
                        Minimum="1"
                        Style="{StaticResource MaterialDesignDiscreteSlider}"
                        TickFrequency="1"
                        Value="{Binding KeepHistory}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label
                        Width="170"
                        Margin="5"
                        Content="除外拡張子"
                        FontSize="14"
                        ToolTip="カンマ区切り。共通設定の走査対象のうち、ここに指定した拡張子を除外します。例: .jpg,.zip" />
                    <TextBox
                        x:Name="ExcludeExt"
                        Width="520"
                        Margin="5"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        FontSize="14"
                        Text="{Binding ExcludeExt}"
                        ToolTip="カンマ区切り。例: .jpg,.zip（. は省略可）" />
                </StackPanel>

                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label
                            Width="170"
                            Margin="5"
                            VerticalAlignment="Top"
                            Content="新規追加時に他スキン用サムネも作成"
                            FontSize="14"
                            ToolTip="この管理ファイルで、監視・フォルダ確認により新規登録されたレコードだけを対象に、下で選んだスキンの未作成サムネを先に作ります。既存ライブラリの穴埋めはしません。既定はオフです。" />
                        <CheckBox
                            x:Name="PreGenThumbsOnNewMoviesCheck"
                            Width="Auto"
                            Margin="5,8,5,5"
                            VerticalAlignment="Top"
                            FontSize="14"
                            Checked="PreGenThumbsOnNewMoviesCheck_Changed"
                            Unchecked="PreGenThumbsOnNewMoviesCheck_Changed" />
                    </StackPanel>
                    <StackPanel Margin="175,0,5,5">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button
                                x:Name="PreGenThumbSelectAllButton"
                                Margin="0,0,8,0"
                                Padding="8,2"
                                Click="PreGenThumbSelectAllButton_Click"
                                Content="すべて選択"
                                FontSize="12"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                            <Button
                                x:Name="PreGenThumbClearButton"
                                Padding="8,2"
                                Click="PreGenThumbClearButton_Click"
                                Content="選択解除"
                                FontSize="12"
                                Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </StackPanel>
                        <ListBox
                            x:Name="PreGenThumbSkinList"
                            MaxHeight="160"
                            MinHeight="80"
                            Padding="4"
                            BorderThickness="1"
                            FontSize="13"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        Content="{Binding DisplayName}"
                                        Focusable="False"
                                        IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Opacity="0.75"
                            Text="この管理ファイル専用です。消したスキンは一覧に出ません。同じサイズのスキンは1回の生成で共有されます。"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>

            </StackPanel>
            </ScrollViewer>

        </materialDesign:ColorZone>
    </Grid>
</Window>
