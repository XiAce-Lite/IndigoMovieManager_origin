<Window
    x:Class="IndigoMovieManager.DmmSearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="DMM 候補検索"
    Width="860"
    Height="560"
    MinWidth="720"
    MinHeight="460"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterOwner">
    <materialDesign:ColorZone
        Padding="12,12,12,0"
        VerticalAlignment="Stretch">
        <Grid Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Margin="0,0,0,8"
                FontSize="13"
                Text="{Binding TargetFileLabel}"
                TextWrapping="Wrap" />

            <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="KeywordBox"
                    Grid.Column="0"
                    Margin="0,0,8,0"
                    materialDesign:HintAssist.Hint="検索語（品番表記の揺れは下の候補をクリック）"
                    materialDesign:TextFieldAssist.HasClearButton="True"
                    materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                    FontSize="14"
                    Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                <Button
                    x:Name="SearchButton"
                    Grid.Column="1"
                    MinWidth="88"
                    Click="SearchButton_Click"
                    Content="検索(_S)" />
            </Grid>

            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                    Text="品番候補（クリックで検索）:" />
                <WrapPanel x:Name="VariantChipsPanel" Margin="0,4,0,0" />
            </StackPanel>

            <TextBlock
                x:Name="StatusText"
                Grid.Row="3"
                Margin="0,0,0,8"
                Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                Text="候補を読み込み中..."
                TextWrapping="Wrap" />

            <DataGrid
                x:Name="CandidatesGrid"
                Grid.Row="4"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                HeadersVisibility="Column"
                IsReadOnly="True"
                PreviewMouseLeftButtonUp="CandidatesGrid_PreviewMouseLeftButtonUp"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectionMode="Single"
                SelectionUnit="Cell">
                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="48"
                        Binding="{Binding JacketLabel}"
                        Header="ジャケ"
                        IsReadOnly="True" />
                    <DataGridTextColumn
                        Width="280"
                        MinWidth="180"
                        Binding="{Binding Title}"
                        Header="タイトル" />
                    <DataGridTextColumn
                        Width="140"
                        MinWidth="100"
                        Binding="{Binding ContentId}"
                        Header="品番" />
                    <DataGridTextColumn
                        Width="240"
                        MinWidth="160"
                        Binding="{Binding MakerLabelSeries}"
                        Header="メーカー / レーベル / シリーズ" />
                    <DataGridTextColumn
                        Width="100"
                        MinWidth="80"
                        Binding="{Binding FloorLabel}"
                        Header="floor" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="5" Margin="0,8,0,0">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                    Text="Powered by FANZA Webサービス"
                    TextWrapping="Wrap" />
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        x:Name="ApplyButton"
                        MinWidth="88"
                        Margin="0,0,8,0"
                        Click="ApplyButton_Click"
                        Content="適用(_A)"
                        IsDefault="True" />
                    <Button
                        x:Name="CloseButton"
                        MinWidth="88"
                        Click="CloseButton_Click"
                        Content="閉じる(_C)"
                        IsCancel="True" />
                </StackPanel>
            </Grid>
        </Grid>
    </materialDesign:ColorZone>
</Window>
