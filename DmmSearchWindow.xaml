<Window
    x:Class="IndigoMovieManager.DmmSearchWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="DMM 候補検索"
    Width="1000"
    Height="760"
    MinWidth="860"
    MinHeight="520"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterOwner">
    <materialDesign:ColorZone
        Padding="12,12,12,0"
        VerticalAlignment="Stretch">
        <!-- 下部ボタンを常に確保し、残りを候補＋プレビューが使う -->
        <DockPanel LastChildFill="True" Margin="0,0,0,8">
            <Grid
                DockPanel.Dock="Bottom"
                Margin="0,8,0,0">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                    Text="Powered by FANZA Webサービス"
                    TextWrapping="Wrap" />
                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        x:Name="JacketRescueButton"
                        MinWidth="108"
                        Margin="0,0,8,0"
                        Click="JacketRescueButton_Click"
                        Content="ジャケ救済(_J)"
                        ToolTip="検索語をそのまま CID として CDN URL を生成します（Comment1 のみ採用可）" />
                    <Button
                        x:Name="AdoptJacketButton"
                        MinWidth="108"
                        Margin="0,0,8,0"
                        Click="AdoptJacketButton_Click"
                        Content="ジャケ採用(_U)"
                        IsEnabled="False"
                        ToolTip="選択中の推定ジャケ URL を Comment1 に保存します" />
                    <Button
                        x:Name="NextPageButton"
                        MinWidth="108"
                        Margin="0,0,8,0"
                        Click="NextPageButton_Click"
                        Content="次の30件(_N)"
                        IsEnabled="False" />
                    <Button
                        x:Name="ApplyButton"
                        MinWidth="88"
                        Margin="0,0,8,0"
                        Click="ApplyButton_Click"
                        Content="適用(_A)" />
                    <Button
                        x:Name="CloseButton"
                        MinWidth="88"
                        Click="CloseButton_Click"
                        Content="閉じる(_C)"
                        IsCancel="True" />
                </StackPanel>
            </Grid>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" MaxHeight="180" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="True">
                    <TextBlock
                        DockPanel.Dock="Left"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="対象:" />
                    <TextBox
                        x:Name="TargetFileNameBox"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        BorderThickness="0"
                        CaretBrush="{DynamicResource MaterialDesign.Brush.Foreground}"
                        FontSize="13"
                        IsReadOnly="True"
                        IsReadOnlyCaretVisible="True"
                        Padding="0"
                        Text="{Binding TargetFileName, Mode=OneWay}"
                        TextWrapping="Wrap"
                        ToolTip="ファイル名を選択してコピーできます"
                        materialDesign:TextFieldAssist.DecorationVisibility="Collapsed">
                        <TextBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem
                                    Command="ApplicationCommands.Copy"
                                    Header="コピー(_C)" />
                            </ContextMenu>
                        </TextBox.ContextMenu>
                    </TextBox>
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="KeywordBox"
                        Grid.Column="0"
                        Margin="0,0,8,0"
                        materialDesign:HintAssist.Hint="検索語（品番表記の揺れは下の候補をクリック）"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                        FontSize="14"
                        Style="{StaticResource MaterialDesignOutlinedTextBox}" />
                    <Button
                        x:Name="SearchButton"
                        Grid.Column="1"
                        MinWidth="72"
                        Margin="0,0,8,0"
                        Click="SearchButton_Click"
                        Content="検索(_S)" />
                    <Button
                        x:Name="PlayButton"
                        Grid.Column="2"
                        Margin="0,0,8,0"
                        MinWidth="72"
                        Click="PlayButton_Click"
                        Content="再生(_P)" />
                    <Button
                        x:Name="TagEditButton"
                        Grid.Column="3"
                        MinWidth="88"
                        Margin="0,0,8,0"
                        Click="TagEditButton_Click"
                        Content="タグ編集(_T)" />
                    <Button
                        x:Name="MetadataEditButton"
                        Grid.Column="4"
                        MinWidth="88"
                        Click="MetadataEditButton_Click"
                        Content="メタ情報(_M)"
                        ToolTip="タイトル・コメント・メーカー・ジャンルを編集します" />
                </Grid>

                <StackPanel Grid.Row="2" Margin="0,0,0,8">
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                        Text="品番候補（クリックで検索）:" />
                    <WrapPanel x:Name="VariantChipsPanel" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="0,0,0,8">
                    <TextBlock
                        x:Name="ModeLabelText"
                        Margin="0,0,0,4"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="表示: DMM 候補" />
                    <TextBlock
                        x:Name="StatusText"
                        Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                        Text="候補を読み込み中..."
                        TextWrapping="Wrap" />
                </StackPanel>

                <DataGrid
                    x:Name="CandidatesGrid"
                    Grid.Row="4"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    CanUserResizeColumns="True"
                    ColumnWidth="*"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    PreviewMouseLeftButtonDown="CandidatesGrid_PreviewMouseLeftButtonDown"
                    PreviewMouseLeftButtonUp="CandidatesGrid_PreviewMouseLeftButtonUp"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionChanged="CandidatesGrid_SelectionChanged"
                    SelectionMode="Single"
                    SelectionUnit="FullRow" />

                <Border
                    Grid.Row="5"
                    Height="160"
                    Margin="0,8,0,0"
                    Background="#FF121212"
                    BorderBrush="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                    BorderThickness="1"
                    CornerRadius="2">
                    <Grid>
                        <TextBlock
                            x:Name="JacketPreviewHint"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="#FF888888"
                            Text="選択行のジャケット（pl）を表示します" />
                        <Image
                            x:Name="JacketPreviewImage"
                            Margin="4"
                            Cursor="Hand"
                            Stretch="Uniform"
                            PreviewMouseLeftButtonDown="JacketPreviewImage_PreviewMouseLeftButtonDown"
                            ToolTip="クリックで拡大表示" />
                    </Grid>
                </Border>
            </Grid>
        </DockPanel>
    </materialDesign:ColorZone>
</Window>
