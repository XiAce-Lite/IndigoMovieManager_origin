<Window
    x:Class="IndigoMovieManager.CommonSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:prop="clr-namespace:IndigoMovieManager.Properties"
    xmlns:controls="clr-namespace:IndigoMovieManager.Controls"
    Title="共通設定"
    Width="800"
    SizeToContent="Height"
    MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Slider.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <materialDesign:ColorZone>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="10" Orientation="Vertical">
                <Button
                    x:Name="BtnReturn"
                    Margin="10,6,0,6"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Click="BtnReturn_Click"
                    Content="戻る(_R)"
                    FontWeight="Normal" />

                <StackPanel Orientation="Horizontal">
                    <Label
                        Width="300"
                        Margin="5"
                        Content="外観（ライト / ダーク / システム）"
                        FontSize="14"
                        ToolTip="WB スキンには影響しません。Indigo スキンで colorProfile 未指定のものは追従します。" />
                    <Border
                        Margin="5"
                        Padding="1"
                        VerticalAlignment="Center"
                        Background="{DynamicResource ImmSettingsSegmentGroupBackground}"
                        BorderBrush="{DynamicResource ImmSettingsSegmentGroupBorder}"
                        BorderThickness="1"
                        CornerRadius="5"
                        SnapsToDevicePixels="True">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton
                                x:Name="ThemeModeLightRadio"
                                Content="ライト"
                                GroupName="ThemeMode"
                                Style="{StaticResource SettingsSegmentRadio}"
                                controls:SegmentRadioAssist.CornerRadius="4,4,0,0" />
                            <RadioButton
                                x:Name="ThemeModeDarkRadio"
                                Margin="-1,0,0,0"
                                Content="ダーク"
                                GroupName="ThemeMode"
                                Style="{StaticResource SettingsSegmentRadio}" />
                            <RadioButton
                                x:Name="ThemeModeSystemRadio"
                                Margin="-1,0,0,0"
                                Content="システム"
                                GroupName="ThemeMode"
                                Style="{StaticResource SettingsSegmentRadio}"
                                ToolTip="Windows の外観設定（ライト / ダーク）に従います。"
                                controls:SegmentRadioAssist.CornerRadius="0,0,4,4" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label
                        Width="300"
                        Margin="5"
                        Content="起動時、最後に開いた管理ファイルを開く"
                        FontSize="14" />
                    <CheckBox
                        x:Name="AutoOpen"
                        Width="Auto"
                        FontSize="14"
                        IsChecked="{Binding AutoOpen, Source={x:Static prop:Settings.Default}}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Label
                        Width="270"
                        Margin="30,5,0,5"
                        Content="最後の管理ファイル"
                        FontSize="14"
                        Foreground="Gray" />
                    <Label
                        Margin="10,5,5,5"
                        Content="{Binding LastDoc, Source={x:Static prop:Settings.Default}}"
                        FontSize="14"
                        Foreground="Gray" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label
                        Width="300"
                        Margin="5"
                        Content="既定の再生プレイヤー"
                        FontSize="14" />
                    <TextBox
                        x:Name="DefaultPlayerPath"
                        Width="400"
                        Margin="5"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        FontSize="14"
                        IsReadOnly="True"
                        Text="{Binding DefaultPlayerPath, Source={x:Static prop:Settings.Default}}"
                        ToolTip="{Binding DefaultPlayerPath}" />
                    <Button
                        x:Name="OpenDialogPlayer"
                        Width="30"
                        Height="30"
                        Click="OpenDialogPlayer_Click"
                        Content="{materialDesign:PackIcon Kind=FolderOpen}"
                        Style="{StaticResource MaterialDesignIconButton}" />

                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label
                        Width="300"
                        Margin="5"
                        Content="再生プレイヤーパラメータ"
                        FontSize="14"
                        ToolTip="&lt;ms&gt;と&lt;file&gt;の置換のみ対応" />
                    <ComboBox
                        x:Name="DefaultPlayerParam"
                        Width="400"
                        Margin="5"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        FontSize="14"
                        IsEditable="True"
                        Text="{Binding DefaultPlayerParam, Source={x:Static prop:Settings.Default}}"
                        ToolTip="&lt;ms&gt;と&lt;file&gt;の置換のみ対応" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label
                        Width="300"
                        Margin="5"
                        Content="ZIP画像ビューワー"
                        FontSize="14"
                        ToolTip="ZIP内の画像を開くときに使うビューワー。未指定時は既定のアプリで開きます。" />
                    <TextBox
                        x:Name="DefaultZipViewerPath"
                        Width="400"
                        Margin="5"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        FontSize="14"
                        IsReadOnly="True"
                        Text="{Binding DefaultZipViewerPath, Source={x:Static prop:Settings.Default}}"
                        ToolTip="{Binding DefaultZipViewerPath}" />
                    <Button
                        x:Name="OpenDialogZipViewer"
                        Width="30"
                        Height="30"
                        Click="OpenDialogZipViewer_Click"
                        Content="{materialDesign:PackIcon Kind=FolderOpen}"
                        Style="{StaticResource MaterialDesignIconButton}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label
                        Width="300"
                        Margin="5"
                        Content="ZIP画像ビューワーパラメータ"
                        FontSize="14"
                        ToolTip="&lt;file&gt;の置換のみ対応" />
                    <ComboBox
                        x:Name="DefaultZipViewerParam"
                        Width="400"
                        Margin="5"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        FontSize="14"
                        IsEditable="True"
                        Text="{Binding DefaultZipViewerParam, Source={x:Static prop:Settings.Default}}"
                        ToolTip="&lt;file&gt;の置換のみ対応" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label
                        Width="300"
                        Margin="5"
                        Content="終了時の確認"
                        FontSize="14" />
                    <CheckBox
                        x:Name="ConfirmExit"
                        Width="Auto"
                        FontSize="14"
                        IsChecked="{Binding ConfirmExit, Source={x:Static prop:Settings.Default}}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label
                        Width="300"
                        Margin="5"
                        Content="サムネイル作成の並列数"
                        FontSize="14"
                        ToolTip="同時に作成するサムネイル数。多いほど速くなりますが、PC負荷も上がります。" />
                    <TextBlock
                        Width="50"
                        Margin="5"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="{Binding ThumbnailParallelism, Source={x:Static prop:Settings.Default}}" />
                    <Slider
                        Width="100"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Maximum="32"
                        Minimum="1"
                        Style="{StaticResource MaterialDesignDiscreteSlider}"
                        TickFrequency="1"
                        Value="{Binding ThumbnailParallelism, Source={x:Static prop:Settings.Default}}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label
                        Width="300"
                        Margin="5"
                        Content="FFmpegハードウェアデコード"
                        FontSize="14"
                        ToolTip="OpenCV失敗時のFFmpegフォールバックでのみ有効。ライト版（essentials）FFmpegでは使えません。gyan.dev の full ビルドまたは同梱版を推奨。失敗時は通常デコードに戻ります。" />
                    <ComboBox
                        x:Name="FfmpegHardwareDecodeModeCombo"
                        Width="400"
                        Margin="5"
                        FontSize="14" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label
                        Width="300"
                        Margin="5"
                        Content="監視・走査対象の拡張子"
                        FontSize="14"
                        ToolTip="カンマ区切り。例: .mp4,.mkv,.mod" />
                    <TextBox
                        x:Name="CheckExt"
                        Width="400"
                        Margin="5"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        FontSize="14"
                        Text="{Binding CheckExt, Source={x:Static prop:Settings.Default}}"
                        ToolTip="カンマ区切り。例: .mp4,.mkv,.mod（. は省略可）" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label
                        Width="300"
                        Margin="5"
                        Content="最近開いた管理ファイルに表示する数"
                        FontSize="14" />
                    <TextBlock
                        x:Name="RecentFiles"
                        Width="50"
                        Margin="5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Text="{Binding RecentFilesCount, Source={x:Static prop:Settings.Default}}" />
                    <Slider
                        x:Name="slider"
                        Width="100"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Maximum="30"
                        Minimum="1"
                        Style="{StaticResource MaterialDesignDiscreteSlider}"
                        TickFrequency="1"
                        Value="{Binding RecentFilesCount, Source={x:Static prop:Settings.Default}}" />
                </StackPanel>

                <Separator Margin="5,12,5,8" />

                <Label
                    Margin="5,0,5,0"
                    Content="DMM Web API（FANZA）"
                    FontSize="16"
                    FontWeight="SemiBold" />

                <TextBlock
                    Margin="5,0,5,8"
                    FontSize="12"
                    Foreground="Gray"
                    TextWrapping="Wrap"
                    Text="利用する場合は各自で DMM アフィリエイト登録と Webサービス申請を行い、API ID と API 用アフィリエイトID（末尾 990〜999）を入力してください。通常の -001 / -002 は API では使えません。キーは GitHub 等へコミットしないでください。" />

                <StackPanel Orientation="Horizontal">
                    <Label
                        Width="300"
                        Margin="5"
                        Content="DMM API ID"
                        FontSize="14" />
                    <TextBox
                        x:Name="DmmApiId"
                        Width="400"
                        Margin="5"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        FontSize="14"
                        Text="{Binding DmmApiId, Source={x:Static prop:Settings.Default}}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Label
                        Width="300"
                        Margin="5"
                        Content="DMM アフィリエイトID（API用）"
                        FontSize="14"
                        ToolTip="末尾が 990〜999 の API 用 ID を指定します。" />
                    <TextBox
                        x:Name="DmmAffiliateId"
                        Width="400"
                        Margin="5"
                        materialDesign:TextFieldAssist.HasClearButton="True"
                        FontSize="14"
                        Text="{Binding DmmAffiliateId, Source={x:Static prop:Settings.Default}}"
                        ToolTip="例: YourName-990" />
                </StackPanel>

                <TextBlock
                    Margin="5,4,5,8"
                    FontSize="12"
                    Text="Powered by FANZA Webサービス" />

            </StackPanel>
            </ScrollViewer>

        </materialDesign:ColorZone>

    </Grid>
</Window>
