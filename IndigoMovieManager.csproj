<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Title>IndigoMovieManager</Title>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <FileVersion>1.0.0.24</FileVersion>
    <AssemblyVersion>1.0.0.24</AssemblyVersion>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>True</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Optimize>True</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="IndigoMovieManager.Tests\**" />
    <None Remove="IndigoMovieManager.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="errorBig.jpg" />
    <None Remove="errorSmall.jpg" />
    <None Remove="errorGrid.jpg" />
    <None Remove="errorList.jpg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Crc32.NET" Version="1.2.0" />
    <PackageReference Include="Dirkster.AvalonDock" Version="4.72.1" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="4.72.1" />
    <PackageReference Include="MaterialDesignColors" Version="5.3.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.0" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    <PackageReference Include="Notification.Wpf" Version="8.0.0" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.11.0.20250507" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.11.0.20250507" />
    <PackageReference Include="System.Data.SQLite" Version="2.0.2" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.2" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.3.2" />
    <!-- SQLite ネイティブバイナリのバンドルを追加 -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.10" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Images\errorBig.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Images\errorSmall.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
      <Content Include="Images\errorGrid.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Images\errorList.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

  </ItemGroup>

  <!-- ffmpeg.exe は .gitignore 対象のため Content+Condition だと VS 読み込み時に除外されやすい。ビルド時コピーにする。 -->
  <Target Name="CopyFfmpegToOutput" AfterTargets="Build">
    <PropertyGroup>
      <_FfmpegSourcePath>$(MSBuildProjectDirectory)\tools\ffmpeg\ffmpeg.exe</_FfmpegSourcePath>
      <_FfmpegDestinationPath>$(OutputPath)ffmpeg\ffmpeg.exe</_FfmpegDestinationPath>
      <_FfprobeSourcePath>$(MSBuildProjectDirectory)\tools\ffmpeg\ffprobe.exe</_FfprobeSourcePath>
      <_FfprobeDestinationPath>$(OutputPath)ffmpeg\ffprobe.exe</_FfprobeDestinationPath>
    </PropertyGroup>
    <MakeDir Directories="$(OutputPath)ffmpeg" Condition="Exists('$(_FfmpegSourcePath)') Or Exists('$(_FfprobeSourcePath)')" />
    <Copy SourceFiles="$(_FfmpegSourcePath)" DestinationFiles="$(_FfmpegDestinationPath)" SkipUnchangedFiles="true" Condition="Exists('$(_FfmpegSourcePath)')" />
    <Copy SourceFiles="$(_FfprobeSourcePath)" DestinationFiles="$(_FfprobeDestinationPath)" SkipUnchangedFiles="true" Condition="Exists('$(_FfprobeSourcePath)')" />
  </Target>

  <!-- sinku.exe / Sinku.dll は .gitignore 対象のため Content+Condition だと VS 読み込み時に除外されやすい。ビルド時コピーにする。 -->
  <Target Name="CopySinkuToOutput" AfterTargets="Build">
    <PropertyGroup>
      <_SinkuSourceDir>$(MSBuildProjectDirectory)\tools\sinku\</_SinkuSourceDir>
    </PropertyGroup>
    <Copy SourceFiles="$(_SinkuSourceDir)sinku.exe" DestinationFiles="$(OutputPath)sinku.exe" SkipUnchangedFiles="true" Condition="Exists('$(_SinkuSourceDir)sinku.exe')" />
    <Copy SourceFiles="$(_SinkuSourceDir)Sinku.dll" DestinationFiles="$(OutputPath)Sinku.dll" SkipUnchangedFiles="true" Condition="Exists('$(_SinkuSourceDir)Sinku.dll')" />
    <Copy SourceFiles="$(_SinkuSourceDir)codecs.ini" DestinationFiles="$(OutputPath)codecs.ini" SkipUnchangedFiles="true" Condition="Exists('$(_SinkuSourceDir)codecs.ini')" />
    <Copy SourceFiles="$(_SinkuSourceDir)format.ini" DestinationFiles="$(OutputPath)format.ini" SkipUnchangedFiles="true" Condition="Exists('$(_SinkuSourceDir)format.ini')" />
  </Target>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <Compile Update="RenameFile.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Images\noFileBig.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Images\noFileGrid.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Images\nofileList.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Images\noFileSmall.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
