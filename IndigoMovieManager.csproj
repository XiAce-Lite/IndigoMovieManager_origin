<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Title>IndigoMovieManager</Title>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <FileVersion>1.0.0.72</FileVersion>
    <AssemblyVersion>1.0.0.72</AssemblyVersion>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <!-- 通常の Release 出力も標準版 publish と同じ SingleFile 構成へ寄せる -->
    <StandardReleaseSingleFile>true</StandardReleaseSingleFile>
    <StandardReleasePublishMirrorDir>$(MSBuildProjectDirectory)\obj\StandardReleaseSingleFile\</StandardReleasePublishMirrorDir>
  </PropertyGroup>

  <!-- 標準配布 publish 用。PublishProfile 名に依存せず CI / ローカルで同じ SingleFile になる -->
  <PropertyGroup Condition="'$(StandardDistributionPublish)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <Optimize>True</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Optimize>True</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="IndigoMovieManager.Tests\**" />
    <None Remove="IndigoMovieManager.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="errorBig.jpg" />
    <None Remove="errorSmall.jpg" />
    <None Remove="errorGrid.jpg" />
    <None Remove="errorList.jpg" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Crc32.NET" Version="1.2.0" />
    <PackageReference Include="Dirkster.AvalonDock" Version="4.72.1" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="4.72.1" />
    <PackageReference Include="MaterialDesignColors" Version="5.3.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.135" />
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.11.0.20250507" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.11.0.20250507" />
    <PackageReference Include="System.Data.SQLite" Version="2.0.2" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.2" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.3.2" />
    <!-- SQLite ネイティブバイナリのバンドルを追加 -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.10" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Skins\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Images\errorBig.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Images\errorSmall.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
      <Content Include="Images\errorGrid.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Images\errorList.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>

  </ItemGroup>

  <!-- ffmpeg は配布物に含めない。開発用 build のみ tools からコピーする。 -->
  <Target Name="CopyFfmpegToOutput" AfterTargets="Build" Condition="'$(PublishSingleFile)' != 'true' and '$(StandardReleaseSingleFile)' != 'true'">
    <PropertyGroup>
      <_FfmpegSourcePath>$(MSBuildProjectDirectory)\tools\ffmpeg\ffmpeg.exe</_FfmpegSourcePath>
      <_FfmpegDestinationPath>$(OutputPath)ffmpeg\ffmpeg.exe</_FfmpegDestinationPath>
      <_FfprobeSourcePath>$(MSBuildProjectDirectory)\tools\ffmpeg\ffprobe.exe</_FfprobeSourcePath>
      <_FfprobeDestinationPath>$(OutputPath)ffmpeg\ffprobe.exe</_FfprobeDestinationPath>
    </PropertyGroup>
    <MakeDir Directories="$(OutputPath)ffmpeg" Condition="Exists('$(_FfmpegSourcePath)') Or Exists('$(_FfprobeSourcePath)')" />
    <Copy SourceFiles="$(_FfmpegSourcePath)" DestinationFiles="$(_FfmpegDestinationPath)" SkipUnchangedFiles="true" Condition="Exists('$(_FfmpegSourcePath)')" />
    <Copy SourceFiles="$(_FfprobeSourcePath)" DestinationFiles="$(_FfprobeDestinationPath)" SkipUnchangedFiles="true" Condition="Exists('$(_FfprobeSourcePath)')" />
  </Target>

  <!-- sinku は開発用 build 向け。配布物は CopyDistributionAssets が publish 出力へコピーする。 -->
  <Target Name="CopySinkuToOutput" AfterTargets="Build" Condition="'$(PublishSingleFile)' != 'true' and '$(StandardReleaseSingleFile)' != 'true'">
    <PropertyGroup>
      <_SinkuSourceDir>$(MSBuildProjectDirectory)\tools\sinku\</_SinkuSourceDir>
    </PropertyGroup>
    <Copy SourceFiles="$(_SinkuSourceDir)sinku.exe" DestinationFiles="$(OutputPath)sinku.exe" SkipUnchangedFiles="true" Condition="Exists('$(_SinkuSourceDir)sinku.exe')" />
    <Copy SourceFiles="$(_SinkuSourceDir)Sinku.dll" DestinationFiles="$(OutputPath)Sinku.dll" SkipUnchangedFiles="true" Condition="Exists('$(_SinkuSourceDir)Sinku.dll')" />
    <Copy SourceFiles="$(_SinkuSourceDir)codecs.ini" DestinationFiles="$(OutputPath)codecs.ini" SkipUnchangedFiles="true" Condition="Exists('$(_SinkuSourceDir)codecs.ini')" />
    <Copy SourceFiles="$(_SinkuSourceDir)format.ini" DestinationFiles="$(OutputPath)format.ini" SkipUnchangedFiles="true" Condition="Exists('$(_SinkuSourceDir)format.ini')" />
  </Target>

  <!-- 標準版配布: SingleFile Exe + Images（ffmpeg / sinku は同梱しない） -->
  <Target Name="CopyDistributionAssets" AfterTargets="Publish">
    <PropertyGroup>
      <_DistDir Condition="'$(_DistDir)' == ''">$(PublishDir)</_DistDir>
      <_ImagesSourceDir>$(MSBuildProjectDirectory)\Images\</_ImagesSourceDir>
    </PropertyGroup>

    <MakeDir Directories="$(_DistDir)Images" />

    <ItemGroup>
      <_DistImage Include="$(_ImagesSourceDir)*.jpg" />
    </ItemGroup>
    <Copy
      SourceFiles="@(_DistImage)"
      DestinationFolder="$(_DistDir)Images"
      SkipUnchangedFiles="true"
      Condition="Exists('$(_ImagesSourceDir)')" />
  </Target>

  <Target
    Name="MirrorStandardReleasePublishToOutput"
    AfterTargets="Build"
    Condition="'$(StandardReleaseSingleFile)' == 'true' and '$(PublishSingleFile)' != 'true' and '$(_RunningStandardReleaseMirror)' != 'true'">
    <RemoveDir
      Directories="$(StandardReleasePublishMirrorDir)"
      Condition="Exists('$(StandardReleasePublishMirrorDir)')" />

    <MSBuild
      Projects="$(MSBuildProjectFullPath)"
      Targets="Publish"
      Properties="Configuration=$(Configuration);Platform=$(Platform);StandardDistributionPublish=true;PublishDir=$(StandardReleasePublishMirrorDir);_RunningStandardReleaseMirror=true" />

    <ItemGroup>
      <_LooseOutputFileToDelete
        Include="$(OutputPath)*.dll;$(OutputPath)*.pdb;$(OutputPath)*.deps.json;$(OutputPath)*.runtimeconfig.json"
        Exclude="$(OutputPath)IndigoMovieManager.dll;$(OutputPath)IndigoMovieManager.deps.json;$(OutputPath)IndigoMovieManager.runtimeconfig.json" />
      <_MirroredPublishFile Include="$(StandardReleasePublishMirrorDir)*" Exclude="$(StandardReleasePublishMirrorDir)Images\**" />
      <_MirroredPublishImage Include="$(StandardReleasePublishMirrorDir)Images\**\*" />
      <_AvalonLocaleDir Include="$(OutputPath)*\" />
    </ItemGroup>

    <Delete Files="@(_LooseOutputFileToDelete)" />
    <RemoveDir Directories="$(OutputPath)ffmpeg" Condition="Exists('$(OutputPath)ffmpeg')" />
    <RemoveDir Directories="$(OutputPath)runtimes" Condition="Exists('$(OutputPath)runtimes')" />
    <RemoveDir Directories="$(OutputPath)win-x64" Condition="Exists('$(OutputPath)win-x64')" />
    <RemoveDir Directories="$(OutputPath)publish" Condition="Exists('$(OutputPath)publish')" />
    <RemoveDir Directories="$(OutputPath)Images" Condition="Exists('$(OutputPath)Images')" />
    <RemoveDir Directories="@(_AvalonLocaleDir)" Condition="Exists('%(_AvalonLocaleDir.Identity)AvalonDock.resources.dll')" />
    <Delete Files="$(OutputPath)sinku.exe;$(OutputPath)Sinku.dll;$(OutputPath)codecs.ini;$(OutputPath)format.ini" />

    <Copy SourceFiles="@(_MirroredPublishFile)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
    <MakeDir Directories="$(OutputPath)Images" />
    <Copy
      SourceFiles="@(_MirroredPublishImage)"
      DestinationFiles="@(_MirroredPublishImage->'$(OutputPath)Images\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <!--
    開発者用ローカル Release 出力には sinku を同梱する（対外配布 publish には入れない）。
    Mirror ターゲットが sinku を削除した後に tools\sinku からコピーし直す。
    StandardDistributionPublish=true（対外配布）と内部 Mirror 実行時は対象外。
  -->
  <Target
    Name="CopySinkuToDeveloperRelease"
    AfterTargets="MirrorStandardReleasePublishToOutput"
    Condition="'$(StandardReleaseSingleFile)' == 'true' and '$(StandardDistributionPublish)' != 'true' and '$(_RunningStandardReleaseMirror)' != 'true' and '$(PublishSingleFile)' != 'true'">
    <PropertyGroup>
      <_SinkuSourceDir>$(MSBuildProjectDirectory)\tools\sinku\</_SinkuSourceDir>
    </PropertyGroup>
    <Copy SourceFiles="$(_SinkuSourceDir)sinku.exe" DestinationFiles="$(OutputPath)sinku.exe" SkipUnchangedFiles="true" Condition="Exists('$(_SinkuSourceDir)sinku.exe')" />
    <Copy SourceFiles="$(_SinkuSourceDir)Sinku.dll" DestinationFiles="$(OutputPath)Sinku.dll" SkipUnchangedFiles="true" Condition="Exists('$(_SinkuSourceDir)Sinku.dll')" />
    <Copy SourceFiles="$(_SinkuSourceDir)codecs.ini" DestinationFiles="$(OutputPath)codecs.ini" SkipUnchangedFiles="true" Condition="Exists('$(_SinkuSourceDir)codecs.ini')" />
    <Copy SourceFiles="$(_SinkuSourceDir)format.ini" DestinationFiles="$(OutputPath)format.ini" SkipUnchangedFiles="true" Condition="Exists('$(_SinkuSourceDir)format.ini')" />
  </Target>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <Compile Update="RenameFile.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Images\noFileBig.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Images\noFileGrid.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Images\nofileList.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Images\noFileSmall.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

</Project>
