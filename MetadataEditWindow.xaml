<Window
    x:Class="IndigoMovieManager.MetadataEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:IndigoMovieManager"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="メタデータ編集"
    Width="480"
    MinHeight="360"
    SizeToContent="Height"
    d:DataContext="{d:DesignInstance Type=local:MetadataEditModel}"
    Background="{DynamicResource MaterialDesign.Brush.Background}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <materialDesign:ColorZone Padding="12">
        <StackPanel Orientation="Vertical">
            <TextBlock
                Margin="0,0,0,12"
                FontSize="14"
                Text="タイトル・コメント・アーティスト・ジャンルを編集します。" />

            <TextBox
                x:Name="TitleBox"
                Margin="0,0,0,10"
                materialDesign:HintAssist.Hint="タイトル"
                materialDesign:TextFieldAssist.HasClearButton="True"
                materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                materialDesign:TextFieldAssist.TextFieldCornerRadius="4"
                BorderThickness="2"
                FontSize="14"
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                TabIndex="1"
                Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <TextBox
                Margin="0,0,0,10"
                materialDesign:HintAssist.Hint="ジャケット表 URL"
                materialDesign:TextFieldAssist.HasClearButton="True"
                materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                materialDesign:TextFieldAssist.TextFieldCornerRadius="4"
                AcceptsReturn="True"
                BorderThickness="2"
                FontSize="14"
                MinHeight="56"
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                TabIndex="2"
                Text="{Binding Comment1, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <TextBox
                Margin="0,0,0,10"
                materialDesign:HintAssist.Hint="コメント2"
                materialDesign:TextFieldAssist.HasClearButton="True"
                materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                materialDesign:TextFieldAssist.TextFieldCornerRadius="4"
                AcceptsReturn="True"
                BorderThickness="2"
                FontSize="14"
                MinHeight="56"
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                TabIndex="3"
                Text="{Binding Comment2, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <TextBox
                Margin="0,0,0,10"
                materialDesign:HintAssist.Hint="メーカー / レーベル / シリーズ"
                materialDesign:TextFieldAssist.HasClearButton="True"
                materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                materialDesign:TextFieldAssist.TextFieldCornerRadius="4"
                AcceptsReturn="True"
                BorderThickness="2"
                FontSize="14"
                MinHeight="72"
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                TabIndex="4"
                Text="{Binding Comment3, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <TextBox
                Margin="0,0,0,10"
                materialDesign:HintAssist.Hint="アーティスト（メーカー等）"
                materialDesign:TextFieldAssist.HasClearButton="True"
                materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                materialDesign:TextFieldAssist.TextFieldCornerRadius="4"
                BorderThickness="2"
                FontSize="14"
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                TabIndex="5"
                Text="{Binding Artist, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <TextBox
                Margin="0,0,0,12"
                materialDesign:HintAssist.Hint="ジャンル"
                materialDesign:TextFieldAssist.HasClearButton="True"
                materialDesign:TextFieldAssist.HasOutlinedTextField="True"
                materialDesign:TextFieldAssist.TextFieldCornerRadius="4"
                BorderThickness="2"
                FontSize="14"
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                TabIndex="6"
                Text="{Binding Genre, UpdateSourceTrigger=PropertyChanged}"
                TextWrapping="Wrap" />

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    x:Name="OK"
                    Margin="0,0,10,0"
                    Click="Button_Click"
                    Content="OK(_R)"
                    IsDefault="True" />
                <Button
                    x:Name="Cancel"
                    Click="Button_Click"
                    Content="Cancel(_C)"
                    IsCancel="true" />
            </StackPanel>
        </StackPanel>
    </materialDesign:ColorZone>
</Window>
