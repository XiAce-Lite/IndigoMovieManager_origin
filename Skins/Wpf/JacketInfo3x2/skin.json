{
  "$schema": "../skin.schema.json",
  "name": "JacketInfo3x2",
  "type": "card",

  "surface": {
    "background": "#FFFFFF"
  },

  "styles": {
    "title": {
      "fontSize": 15,
      "foreground": "#000000",
      "bold": true,
      "wrap": true
    },
    "meta": {
      "fontSize": 12,
      "foreground": "#555555"
    },
    "path": {
      "fontSize": 11,
      "foreground": "#888888",
      "wrap": true
    }
  },

  "thumbnail": {
    "width": 360,
    "height": 203,
    "columns": 3,
    "rows": 2,
    "preferJacket": true
  },

  "card": {
    "width": 645,
    "height": 0,
    "padding": 8,
    "stretch": false,
    "background": "",

    "layout": {
      "panel": "grid",
      "columns": ["360", "*"],
      "rows": ["auto"],
      "children": [
        {
          "type": "thumbnail",
          "col": 0,
          "row": 0,
          "width": 360,
          "vAlign": "top",
          "hAlign": "left"
        },
        {
          "panel": "stack",
          "stack": "vertical",
          "col": 1,
          "row": 0,
          "margin": 4,
          "vAlign": "top",
          "children": [
            {
              "type": "text",
              "field": "title",
              "style": "title",
              "wrap": true,
              "margin": "0,0,0,4"
            },
            { "type": "text", "field": "length", "label": "尺: ", "style": "meta" },
            { "type": "text", "field": "size", "label": "サイズ: ", "format": "filesize", "style": "meta" },
            { "type": "text", "field": "fileDate", "label": "更新: ", "style": "meta" },
            { "type": "text", "field": "video", "label": "映像: ", "style": "meta" },
            { "type": "text", "field": "audio", "label": "音声: ", "style": "meta" },
            { "type": "text", "field": "path", "style": "path" },
            { "type": "tags", "margin": "0,6,0,0" }
          ]
        }
      ]
    }
  }
}
