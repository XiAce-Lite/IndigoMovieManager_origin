{
  "$schema": "../skin.schema.json",
  "name": "SmallCard",
  "type": "card",

  "surface": {
    "background": ""
  },

  "styles": {
    "title": { "fontSize": 14, "foreground": "#000000", "bold": true, "wrap": true },
    "meta":  { "fontSize": 12, "foreground": "#555555" }
  },

  "thumbnail": {
    "width": 360,
    "height": 203,
    "columns": 3,
    "rows": 1
  },

  "card": {
    "width": 550,
    "padding": 2,
    "background": "",

    "layout": {
      "panel": "grid",
      "rows": ["auto", "auto"],
      "columns": ["1*"],
      "children": [
        {
          "panel": "grid",
          "row": 0,
          "col": 0,
          "columns": ["360", "1*"],
          "rows": ["auto"],
          "children": [
            { "type": "thumbnail", "col": 0, "valign": "top", "width": 360, "height": 68 },
            {
              "stack": "vertical",
              "col": 1,
              "margin": 8,
              "children": [
                { "type": "text", "field": "title",    "style": "title" },
                { "type": "text", "field": "length",   "label": "尺: ",     "style": "meta" },
                { "type": "text", "field": "size",      "label": "サイズ: ", "format": "filesize", "style": "meta" },
                { "type": "text", "field": "fileDate",  "label": "更新: ",   "style": "meta" },
                { "type": "text", "field": "ext",       "label": "種類: ",   "style": "meta", "foreground": "#888888" }
              ]
            }
          ]
        },
        { "type": "tags", "row": 1, "col": 0, "width": 550 }
      ]
    }
  }
}
