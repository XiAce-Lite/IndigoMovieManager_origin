{
  "$schema": "../skin.schema.json",
  "name": "TinySample",
  "type": "card",

  "surface": {
    "background": "#FFFFFF"
  },

  "styles": {
    "title": { "fontFamily": "Yu Gothic UI", "fontSize": 10, "foreground": "#000000" }
  },

  "thumbnail": {
    "width": 80,
    "height": 45,
    "columns": 2,
    "rows": 1
  },

  "card": {
    "width": 180,
    "padding": 2,
    "margin": 0,
    "background": "",

    "layout": {
      "stack": "vertical",
      "children": [
        { "type": "thumbnail", "width": 160, "height": 45 },
        { "type": "text", "field": "title", "style": "title", "width": 160 }
      ]
    }
  }
}
