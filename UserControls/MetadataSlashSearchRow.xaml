<UserControl
    x:Class="IndigoMovieManager.UserControls.MetadataSlashSearchRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="24"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="MetadataSegmentStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="TextDecorations" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="TextDecorations" Value="Underline" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MetadataSeparatorStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            <Setter Property="Text" Value=" / " />
        </Style>
    </UserControl.Resources>
    <DockPanel
        LastChildFill="True"
        PreviewKeyDown="MetadataSlashSearchRow_PreviewKeyDown"
        PreviewKeyUp="MetadataSlashSearchRow_PreviewKeyUp">
        <TextBlock
            x:Name="LabelText"
            Width="72"
            DockPanel.Dock="Left"
            FontSize="12"
            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
            Opacity="0.7" />
        <WrapPanel x:Name="SegmentsPanel" />
    </DockPanel>
</UserControl>
