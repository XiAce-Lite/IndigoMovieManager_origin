<UserControl
    x:Class="IndigoMovieManager.UserControls.ExtDetail"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="clr-namespace:IndigoMovieManager.Converter"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:indigomoviemanager="clr-namespace:IndigoMovieManager"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:view="clr-namespace:IndigoMovieManager.UserControls"
    d:DataContext="{d:DesignInstance Type=indigomoviemanager:MovieRecords}"
    d:DesignHeight="250"
    d:DesignWidth="740"
    mc:Ignorable="d">

    <UserControl.Resources>
        <c:FileSizeConverter x:Key="FileSizeConverter" />
        <c:NoLockImageConverter x:Key="noLockImageConverter" />
        <c:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibility" />
        <Style x:Key="MetadataRowStyle" TargetType="Border">
            <Setter Property="Padding" Value="0,2,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.85" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="JacketNavButtonStyle" TargetType="Button" BasedOn="{StaticResource MaterialDesignIconButton}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.35" />
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MaterialDesign.Brush.Background}">
        <VirtualizingStackPanel
            Orientation="Vertical"
            ScrollViewer.IsDeferredScrollingEnabled="true"
            VirtualizingPanel.IsVirtualizing="True"
            VirtualizingPanel.VirtualizationMode="Recycling">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- 表示枠: 旧160幅×2=320、高さはジャケ比 800×538（320×538/800≈215） -->
                <StackPanel
                    Width="320"
                    HorizontalAlignment="Left">
                    <Label
                        x:Name="LabelExtDetail"
                        Width="320"
                        Height="215"
                        Padding="0"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        MouseDoubleClick="Label_MouseDoubleClick">
                        <Image
                            x:Name="DetailImage"
                            d:Source="../Images/errorGrid.jpg"
                            ContextMenu="{DynamicResource menuContext}"
                            PreviewMouseLeftButtonDown="ThumbnailImage_PreviewMouseLeftButtonDown"
                            Stretch="Uniform" />
                    </Label>
                    <StackPanel
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        Orientation="Horizontal">
                        <Button
                            x:Name="JacketPrevButton"
                            Margin="0,0,6,0"
                            Click="JacketPrevButton_Click"
                            Content="{materialDesign:PackIcon Kind=ChevronLeft}"
                            IsEnabled="False"
                            Style="{StaticResource JacketNavButtonStyle}"
                            ToolTip="ジャケット表（◀）" />
                        <Button
                            x:Name="JacketNextButton"
                            Click="JacketNextButton_Click"
                            Content="{materialDesign:PackIcon Kind=ChevronRight}"
                            IsEnabled="False"
                            Style="{StaticResource JacketNavButtonStyle}"
                            ToolTip="詳細サムネイル（▶）" />
                    </StackPanel>
                </StackPanel>
            </Grid>

        </VirtualizingStackPanel>

        <VirtualizingStackPanel
            Width="Auto"
            Margin="330,3,3,3"
            Orientation="Vertical"
            VirtualizingPanel.IsVirtualizing="true"
            VirtualizingPanel.VirtualizationMode="Recycling">

            <VirtualizingStackPanel
                Orientation="Horizontal"
                VirtualizingPanel.IsVirtualizing="true"
                VirtualizingPanel.VirtualizationMode="Recycling">
                <Label
                    Width="Auto"
                    Margin="0,4,0,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    FontSize="18"
                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">

                    <Hyperlink
                        x:Name="FileNameLink"
                        Background="Transparent"
                        Hyperlink.Click="FileNameLink_Click"
                        NavigateUri="{Binding Movie_Body}">
                        <TextBlock d:Text="ダミーファイル" Text="{Binding Movie_Body, UpdateSourceTrigger=PropertyChanged}" />
                    </Hyperlink>
                </Label>

                <Label
                    Width="Auto"
                    Margin="4,4,0,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    FontSize="18"
                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">

                    <Hyperlink
                        x:Name="Ext"
                        Background="Transparent"
                        Hyperlink.Click="Ext_Click"
                        NavigateUri="{Binding Ext}">
                        <TextBlock d:Text=".mp4" Text="{Binding Ext, UpdateSourceTrigger=PropertyChanged}" />
                    </Hyperlink>
                </Label>

            </VirtualizingStackPanel>
            <Label
                Width="Auto"
                Margin="0,4,0,0"
                Padding="0"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderBrush="Transparent"
                FontSize="16"
                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}">

                <Hyperlink
                    Background="Transparent"
                    Hyperlink.Click="Hyperlink_Click"
                    NavigateUri="{Binding Dir, FallbackValue='C:\\'}">
                    <TextBlock d:Text="C:\xxxxx\xxxxx\xxxxx" Text="{Binding Dir, UpdateSourceTrigger=PropertyChanged}" />
                </Hyperlink>
            </Label>

            <ItemsControl
                x:Name="ExtDetailTags"
                Height="Auto"
                Margin="0,4,0,6"
                d:Height="50"
                ItemsSource="{Binding Tag, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                ScrollViewer.IsDeferredScrollingEnabled="True"
                VirtualizingPanel.IsContainerVirtualizable="True"
                VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.ScrollUnit="Pixel"
                VirtualizingPanel.VirtualizationMode="Recycling">

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <view:TagControl DataContext="{Binding}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel
                            Width="Auto"
                            Height="Auto"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>

            <StackPanel
                Margin="0,0,0,4"
                PreviewKeyDown="MetadataPanel_PreviewKeyDown"
                PreviewKeyUp="MetadataPanel_PreviewKeyUp">
                <Border
                    HorizontalAlignment="Left"
                    MouseLeftButtonDown="MetadataRow_MouseLeftButtonDown"
                    Style="{StaticResource MetadataRowStyle}"
                    Tag="{Binding Title}"
                    ToolTip="{Binding Title, StringFormat='{}{0}&#10;クリックで検索'}"
                    Visibility="{Binding Title, Converter={StaticResource NullOrEmptyToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="72"
                            FontSize="12"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Opacity="0.7"
                            Text="タイトル:" />
                        <TextBlock
                            MaxWidth="560"
                            FontSize="12"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border
                    HorizontalAlignment="Left"
                    MouseLeftButtonDown="CommentRow_MouseLeftButtonDown"
                    Style="{StaticResource MetadataRowStyle}"
                    Tag="{Binding Comment1}"
                    Visibility="{Binding Comment1, Converter={StaticResource NullOrEmptyToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="72"
                            FontSize="12"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Opacity="0.7"
                            Text="コメント1:" />
                        <TextBlock
                            x:Name="Comment1Value"
                            MaxWidth="560"
                            FontSize="12"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Text="{Binding Comment1}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border
                    HorizontalAlignment="Left"
                    MouseLeftButtonDown="CommentRow_MouseLeftButtonDown"
                    Style="{StaticResource MetadataRowStyle}"
                    Tag="{Binding Comment2}"
                    Visibility="{Binding Comment2, Converter={StaticResource NullOrEmptyToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="72"
                            FontSize="12"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Opacity="0.7"
                            Text="コメント2:" />
                        <TextBlock
                            x:Name="Comment2Value"
                            MaxWidth="560"
                            FontSize="12"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Text="{Binding Comment2}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <view:MetadataSlashSearchRow
                    Label="コメント3:"
                    Value="{Binding Comment3}"
                    Visibility="{Binding Comment3, Converter={StaticResource NullOrEmptyToVisibility}}" />
                <Border
                    HorizontalAlignment="Left"
                    MouseLeftButtonDown="MetadataRow_MouseLeftButtonDown"
                    Style="{StaticResource MetadataRowStyle}"
                    Tag="{Binding Artist}"
                    ToolTip="{Binding Artist, StringFormat='{}{0}&#10;クリックで検索'}"
                    Visibility="{Binding Artist, Converter={StaticResource NullOrEmptyToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="72"
                            FontSize="12"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Opacity="0.7"
                            Text="メーカー:" />
                        <TextBlock
                            MaxWidth="560"
                            FontSize="12"
                            Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                            Text="{Binding Artist}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <view:MetadataSlashSearchRow
                    Label="ジャンル:"
                    Value="{Binding Genre}"
                    Visibility="{Binding Genre, Converter={StaticResource NullOrEmptyToVisibility}}" />
            </StackPanel>

            <VirtualizingStackPanel
                Margin="0,4,0,0"
                Orientation="Horizontal"
                VirtualizingPanel.IsVirtualizing="true"
                VirtualizingPanel.VirtualizationMode="Recycling">
                <TextBlock
                    Padding="0"
                    d:Text="99,99GB"
                    FontSize="12"
                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                    Text="{Binding Movie_Size, Converter={StaticResource FileSizeConverter}}" />
                <TextBlock
                    Padding="0"
                    FontSize="12"
                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                    Text=" / " />
                <TextBlock
                    Padding="0"
                    d:Text="XX:XX:XX"
                    FontSize="12"
                    Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                    Text="{Binding Movie_Length}" />

            </VirtualizingStackPanel>

            <TextBlock
                Margin="0,0,0,0"
                Padding="0"
                d:Text="MP4"
                FontSize="12"
                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                Text="{Binding Container}" />
            <TextBlock
                Padding="0"
                d:Text="1980x1024 xxx xxxx"
                FontSize="12"
                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                Text="{Binding Video}" />
            <TextBlock
                Padding="0"
                d:Text="aac"
                FontSize="12"
                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                Text="{Binding Audio}" />
            <TextBlock
                Padding="0"
                d:Text="2023/01/01 00:00:00"
                FontSize="12"
                Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                Text="{Binding File_Date}" />

        </VirtualizingStackPanel>
    </Grid>
</UserControl>
